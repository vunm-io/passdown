32276	32093	0	Fri Sep 25 13:21:03 2026	/bin/zsh -c -l SNAPSHOT_FILE=~/.claude/shell-snapshots/snapshot-zsh-1790317263906-zgcobs.sh\012 source "~/.zshrc" < /dev/null\012\012 # First, create/clear the snapshot file\012 echo "# Snapshot file" >| "$SNAPSHOT_FILE"\012\012 # When this file is sourced, we first unalias to avoid conflicts\012 # This is necessary because aliases get "frozen" inside function definitions at definition time,\012 # which can cause unexpected behavior when functions use commands that conflict with aliases\012 echo "# Unset all aliases to avoid conflicts with functions" >> "$SNAPSHOT_FILE"\012 echo "unalias -a 2>/dev/null || true" >> "$SNAPSHOT_FILE"\012\012 \012 echo "# Functions" >> "$SNAPSHOT_FILE"\012\012 # Force autoload all functions first\012 typeset -f > /dev/null 2>&1\012\012 # Now get user function names - filter completion functions (single underscore prefix)\012 # but keep double-underscore helpers (e.g. __zsh_like_cd from mise, __pyenv_init)\012 typeset +f | grep -vE '^_[^_]' | while read func; do\012 typeset -f "$func" >> "$SNAPSHOT_FILE"\012 done\012 \012 echo "# Shell Options" >> "$SNAPSHOT_FILE"\012 setopt | sed 's/^/setopt /' | head -n 1000 >> "$SNAPSHOT_FILE"\012 \012 echo "# Aliases" >> "$SNAPSHOT_FILE"\012 # Filter out winpty aliases on Windows to avoid "stdin is not a tty" errors\012 # Git Bash automatically creates aliases like "alias node='winpty node.exe'" for\012 # programs that need Win32 Console in mintty, but winpty fails when there's no TTY\012 if [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]]; then\012 alias | grep -v "='winpty " | sed 's/^alias //g' | sed 's/^/alias -- /' | head -n 1000 >> "$SNAPSHOT_FILE"\012 else\012 alias | sed 's/^alias //g' | sed 's/^/alias -- /' | head -n 1000 >> "$SNAPSHOT_FILE"\012 fi\012 \012\012 \012 # Check for rg availability\012 echo "# Check for rg availability" >> "$SNAPSHOT_FILE"\012 echo "if ! (unalias rg 2>/dev/null; command -v rg) >/dev/null 2>&1; then" >> "$SNAPSHOT_FILE"\012 \012 cat >> "$SNAPSHOT_FILE" << 'RIPGREP_FUNC_END'\012 function rg {\012 local _cc_bin="${CLAUDE_CODE_EXECPATH:-}"\012 [[ -x $_cc_bin ]] || _cc_bin=~/.local/bin/claude\012 if [[ ! -x $_cc_bin ]]; then command rg ${1+"$@"}; return; fi\012 if [[ -n ${ZSH_VERSION:-} ]]; then\012 ARGV0=rg "$_cc_bin" ${1+"$@"}\012 elif [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "win32" ]]; then\012 ARGV0=rg "$_cc_bin" ${1+"$@"}\012 else\012 (exec -a rg "$_cc_bin" ${1+"$@"})\012 fi\012}\012RIPGREP_FUNC_END\012 \012 echo "fi" >> "$SNAPSHOT_FILE"\012 \012 # Shadow find/grep with embedded bfs/ugrep (ant-native only)\012 echo "# Shadow find/grep with embedded bfs/ugrep" >> "$SNAPSHOT_FILE"\012 cat >> "$SNAPSHOT_FILE" << 'FIND_GREP_FUNC_END'\012unalias find 2>/dev/null || true\012unalias grep 2>/dev/null || true\012function find {\012 local _cc_bin="${CLAUDE_CODE_EXECPATH:-}"\012 [[ -x $_cc_bin ]] || _cc_bin=~/.local/bin/claude\012 if [[ ! -x $_cc_bin ]]; then command find ${1+"$@"}; return; fi\012 if [[ -n ${ZSH_VERSION:-} ]]; then\012 ARGV0=bfs "$_cc_bin" -S dfs -regextype findutils-default ${1+"$@"}\012 elif [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "win32" ]]; then\012 ARGV0=bfs "$_cc_bin" -S dfs -regextype findutils-default ${1+"$@"}\012 else\012 (exec -a bfs "$_cc_bin" -S dfs -regextype findutils-default ${1+"$@"})\012 fi\012}\012function grep {\012 local _cc_a\012 for _cc_a in ${1+"$@"}; do\012 case "$_cc_a" in -*-filter*|-*-pager*|-*-view*|-*-format-open*|-*-config*|---*|-@*|-*-save-config*|-[Zz]*|-[!-]*[Zz]*|--null|--null-data) command grep ${1+"$@"}; return ;; esac\012 done\012 local _cc_bin="${CLAUDE_CODE_EXECPATH:-}"\012 [[ -x $_cc_bin ]] || _cc_bin=~/.local/bin/claude\012 if [[ ! -x $_cc_bin ]]; then command grep ${1+"$@"}; return; fi\012 if [[ -n ${ZSH_VERSION:-} ]]; then\012 ARGV0=ugrep "$_cc_bin" -G --ignore-files --hidden -I --exclude-dir=.git --exclude-dir=.svn --exclude-dir=.hg --exclude-dir=.bzr --exclude-dir=.jj --exclude-dir=.sl ${1+"$@"}\012 elif [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "win32" ]]; then\012 ARGV0=ugrep "$_cc_bin" -G --ignore-files --hidden -I --exclude-dir=.git --exclude-dir=.svn --exclude-dir=.hg --exclude-dir=.bzr --exclude-dir=.jj --exclude-dir=.sl ${1+"$@"}\012 else\012 (exec -a ugrep "$_cc_bin" -G --ignore-files --hidden -I --exclude-dir=.git --exclude-dir=.svn --exclude-dir=.hg --exclude-dir=.bzr --exclude-dir=.jj --exclude-dir=.sl ${1+"$@"})\012 fi\012}\012FIND_GREP_FUNC_END\012 \012\012 # Add PATH to the file\012 cat >> "$SNAPSHOT_FILE" << 'PATH_END_1431v4b916le'\012export PATH='~/.cargo/bin:~/.local/bin:~/.nvm/versions/node/v24.18.0/bin:/opt/homebrew/Cellar/pyenv-virtualenv/1.4.0/shims:~/.pyenv/shims:/usr/local/bin:/System/Cryptexes/App/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/local/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/bin:/var/run/com.apple.security.cryptexd/codex.system/bootstrap/usr/appleinternal/bin:/pkg/env/global/bin:/Library/Apple/usr/bin:/opt/homebrew/bin:~/Library/Application Support/JetBrains/Toolbox/scripts:~/Library/Application Support/Claude/local-agent-mode-sessions/ebb8804c-b89d-469b-b109-984f626df199/fca9c519-0b04-420d-9bfa-7586999b2d81/rpm/plugin_01FTLa86dhbVJ3HB1LdHdhN7/bin:~/Library/Application Support/Claude/local-agent-mode-sessions/skills-plugin/fca9c519-0b04-420d-9bfa-7586999b2d81/ebb8804c-b89d-469b-b109-984f626df199/bin:~/.claude/plugins/cache/claude-plugins-official/superpowers/6.3.0/bin:~/.claude/plugins/cache/passdown/passdown/0.4.0/bin:~/.claude/plugins/cache/cloudflare/cloudflare/1.0.0/bin:~/.claude/plugins/cache/claude-plugins-official/superpowers/6.3.0/bin:~/.claude/plugins/cache/passdown/passdown/0.4.0/bin:~/.claude/plugins/cache/cloudflare/cloudflare/1.0.0/bin'\012PATH_END_1431v4b916le\012 \012\012 # Exit silently on success, only report errors\012 if [ ! -f "$SNAPSHOT_FILE" ]