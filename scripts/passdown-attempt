#!/usr/bin/env bash
# passdown-attempt — deterministic helper for Passdown v0.5 attempt receipts.
#
# Stateless: every invocation reads files, checks the protocol rules, writes
# files atomically and exits. It never launches, signals, waits for or
# monitors a worker, opens a network connection, runs in the background or
# edits a plan file. Design: docs/design/PDN-0004-v05-acceptance-recovery.md
# (sections 6-13) in https://github.com/vunm-io/passdown.
#
# Canonical source: scripts/passdown-attempt. The copies under
# plugins/passdown/skills/*/scripts/ are generated by scripts/sync-bundled.sh.
#
# Requires bash >= 3.2, jq >= 1.6 and git.
# jq programs are single-quoted on purpose (SC2016), and `[ a ] && [ b ] ||
# die` means "unless both hold, die" throughout (SC2015).
# shellcheck disable=SC2016,SC2015
set -euo pipefail

PASSDOWN_VERSION="0.5.0-beta.1"

# Git Bash on Windows rewrites every argument that looks like a POSIX path
# before a native program (jq.exe) sees it: `--arg p /holder` would arrive as
# `C:/Program Files/Git/holder`. Automatic conversion is off, and the jq
# wrapper below converts exactly the arguments jq opens as files.
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) JQ_NATIVE_PATHS=1 ;;
  *) JQ_NATIVE_PATHS=0 ;;
esac
jq() {
  if [ "$JQ_NATIVE_PATHS" = 0 ]; then
    command jq "$@"
    return
  fi
  local args=() filter_seen=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --arg | --argjson)
        args+=("$1" "$2" "$3")
        shift 3
        ;;
      --slurpfile | --rawfile)
        args+=("$1" "$2" "$(cygpath -m "$3")")
        shift 3
        ;;
      -*)
        args+=("$1")
        shift
        ;;
      *)
        if [ "$filter_seen" = 0 ]; then
          args+=("$1")
          filter_seen=1
        else
          args+=("$(cygpath -m "$1")")
        fi
        shift
        ;;
    esac
  done
  command jq "${args[@]}"
}

HELPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# Exit codes (design section 10.3).
E_USAGE=2
E_STATE=3
E_INVALID=4
E_REV=5
E_GUARD=6

JSON_OUT=0
STORE=""
CARD_DIRS="${PASSDOWN_EXECUTOR_REFS:-}"

# JSON Schema evaluator and protocol invariants (jq). See tests/attempt.sh for
# the conformance test against the published schemas.
SCHEMA_LIB="$(cat <<'JQ'
# Minimal JSON Schema (draft 2020-12) evaluator for the passdown protocol
# schemas. It supports exactly the keywords schemas/protocol/*.json use:
# $ref (local #/$defs/...), type, const, enum, pattern, minLength, maxLength,
# minimum, required, properties, patternProperties, additionalProperties,
# items, minItems, maxItems, uniqueItems, contains, allOf, anyOf, oneOf, not,
# if/then/else. Annotation keywords ($schema, $id, $comment, title,
# description) are ignored. An unknown keyword is an error, so a schema edit
# that needs more than this evaluator supports fails loudly.
#
# sv_errors($root): input is the instance; output is an array of
# {path, keyword, missing?, extra?}, where path is a JSON pointer.

def sv_known: [
  "$schema", "$id", "$comment", "$defs", "title", "description", "$ref",
  "type", "const", "enum", "pattern", "minLength", "maxLength", "minimum",
  "required", "properties", "patternProperties", "additionalProperties",
  "items", "minItems", "maxItems", "uniqueItems", "contains",
  "allOf", "anyOf", "oneOf", "not", "if", "then", "else"
];

def sv_ptr($p; $k): $p + "/" + ($k | tostring | gsub("~"; "~0") | gsub("/"; "~1"));

def sv_is($t):
  if $t == "integer" then (type == "number" and . == floor)
  elif $t == "number" then type == "number"
  else type == $t end;

def sv($root; $s; $p):
  . as $i
  | if $s == true then []
    elif $s == false then [{path: $p, keyword: "false"}]
    elif ($s | has("$ref")) then
      ($s["$ref"] | ltrimstr("#/") | split("/")) as $ks
      | sv($root; ($root | getpath($ks)); $p)
    else
      ([$s | keys[] | select(. as $k | sv_known | index([$k]) | not)]) as $unknown
      | if $unknown != [] then error("unsupported schema keyword(s): \($unknown | join(", "))") else . end
      | [
          ( if ($s | has("type")) and ([$s.type] | flatten | any(. as $t | $i | sv_is($t)) | not)
            then {path: $p, keyword: "type"} else empty end ),
          ( if ($s | has("const")) and $i != $s.const then {path: $p, keyword: "const"} else empty end ),
          ( if ($s | has("enum")) and (any($s.enum[]; . == $i) | not) then {path: $p, keyword: "enum"} else empty end ),
          ( if ($i | type) == "string" then
              ( if ($s | has("pattern")) and ($i | test($s.pattern) | not) then {path: $p, keyword: "pattern"} else empty end ),
              ( if ($s | has("minLength")) and ($i | length) < $s.minLength then {path: $p, keyword: "minLength"} else empty end ),
              ( if ($s | has("maxLength")) and ($i | length) > $s.maxLength then {path: $p, keyword: "maxLength"} else empty end )
            else empty end ),
          ( if ($i | type) == "number" and ($s | has("minimum")) and $i < $s.minimum
            then {path: $p, keyword: "minimum"} else empty end ),
          ( if ($i | type) == "object" then
              ( ($s.required // [])[] | select(. as $k | $i | has($k) | not)
                | {path: $p, keyword: "required", missing: .} ),
              ( ($s.properties // {}) | to_entries[] | select(.key as $k | $i | has($k))
                | .key as $k | .value as $sub | ($i[$k] | sv($root; $sub; sv_ptr($p; $k)))[] ),
              ( ($s.patternProperties // {}) | to_entries[] as $pp
                | $i | keys[] | select(test($pp.key)) as $k
                | ($i[$k] | sv($root; $pp.value; sv_ptr($p; $k)))[] ),
              ( if ($s | has("additionalProperties")) then
                  $i | keys[]
                  | select(. as $k | ($s.properties // {}) | has($k) | not)
                  | select(. as $k | ($s.patternProperties // {}) | keys | any(. as $re | $k | test($re)) | not)
                  | . as $k
                  | if $s.additionalProperties == false then {path: $p, keyword: "additionalProperties", extra: $k}
                    else ($i[$k] | sv($root; $s.additionalProperties; sv_ptr($p; $k)))[] end
                else empty end )
            else empty end ),
          ( if ($i | type) == "array" then
              ( if ($s | has("items")) then
                  range(0; $i | length) as $n | ($i[$n] | sv($root; $s.items; sv_ptr($p; $n)))[]
                else empty end ),
              ( if ($s | has("minItems")) and ($i | length) < $s.minItems then {path: $p, keyword: "minItems"} else empty end ),
              ( if ($s | has("maxItems")) and ($i | length) > $s.maxItems then {path: $p, keyword: "maxItems"} else empty end ),
              ( if ($s.uniqueItems // false) and ($i | length) != ($i | unique | length)
                then {path: $p, keyword: "uniqueItems"} else empty end ),
              ( if ($s | has("contains")) then
                  [range(0; $i | length) as $n | $i[$n] | sv($root; $s.contains; sv_ptr($p; $n))] as $r
                  | if any($r[]; . == []) then empty else ($r[][]), {path: $p, keyword: "contains"} end
                else empty end )
            else empty end ),
          ( ($s.allOf // [])[] as $sub | ($i | sv($root; $sub; $p))[] ),
          ( if ($s | has("anyOf")) then
              [$s.anyOf[] as $sub | $i | sv($root; $sub; $p)] as $r
              | if any($r[]; . == []) then empty else ($r[][]), {path: $p, keyword: "anyOf"} end
            else empty end ),
          ( if ($s | has("oneOf")) then
              [$s.oneOf[] as $sub | $i | sv($root; $sub; $p)] as $r
              | ([$r[] | select(. == [])] | length) as $ok
              | if $ok == 1 then empty
                elif $ok == 0 then ($r[][]), {path: $p, keyword: "oneOf"}
                else {path: $p, keyword: "oneOf"} end
            else empty end ),
          ( if ($s | has("not")) and ($i | sv($root; $s.not; $p)) == [] then {path: $p, keyword: "not"} else empty end ),
          ( if ($s | has("if")) then
              (if ($i | sv($root; $s.if; $p)) == [] then
                 (if ($s | has("then")) then ($i | sv($root; $s.then; $p)) else [] end)
               else
                 (if ($s | has("else")) then ($i | sv($root; $s.else; $p)) else [] end)
               end) as $branch
              | if $branch == [] then empty else ($branch[], {path: $p, keyword: "if"}) end
            else empty end )
        ]
    end;

def sv_errors($root): sv($root; $root; "");

# Result diagnostics (design section 7) from schema errors.
def result_diagnostic:
  if .keyword == "additionalProperties" then "unknown-member"
  elif (.keyword == "minLength" or .keyword == "maxLength" or .keyword == "maxItems") then "length"
  elif (.path | test("^/(changed_paths/[0-9]+/path|question/context_paths/[0-9]+)$")) then "path"
  elif .path == "/schema" then "schema-version"
  elif .path == "/attempt" then "attempt-mismatch"
  elif .path == "/disposition" then "disposition"
  elif .keyword == "required" and .path == "" and (.missing == "question" or .missing == "blocker") then .missing
  elif (.path | startswith("/question")) then "question"
  elif (.path | startswith("/blocker")) then "blocker"
  else "structure" end;

# Receipt invariants JSON Schema cannot express (design sections 6, 8.5,
# 10.4, 12). Input: receipt. Output: array of rule codes; the codes are the
# fixture names in tests/fixtures/attempt/receipts/semantic-invalid/.
def receipt_semantic_errors:
  . as $r
  | [
      ( if $r.verdict.acceptance == "accepted" and $r.verdict.task_digest != $r.task.digest
        then "accepted-task-digest-mismatch" else empty end ),
      ( if $r.verdict.acceptance == "accepted" and $r.verdict.artifact_digest != $r.artifact.digest
        then "accepted-artifact-digest-mismatch" else empty end ),
      ( if ($r.artifact.inspections | length) > 0 and $r.artifact.digest != $r.artifact.inspections[-1].digest
        then "artifact-digest-not-latest-inspection" else empty end ),
      ( if $r.kind == "reemit" and $r.verdict.acceptance == "accepted" and $r.artifact.at_arm != $r.artifact.digest
        then "reemit-accepted-with-own-writes" else empty end ),
      ( if $r.kind == "reemit" and $r.artifact.at_arm != null and $r.artifact.expected != $r.artifact.at_arm
        then "reemit-expected-not-digest" else empty end ),
      ( if $r.continues == null and $r.chain_root != $r.id then "chain-root-not-self" else empty end ),
      ( if $r.continues != null and $r.chain_root == $r.id then "chain-root-self-on-continuation" else empty end ),
      ( if $r.continues == $r.id then "continues-self" else empty end ),
      ( if $r.claim != null and $r.claim.transferred_to == $r.id then "transferred-to-self" else empty end ),
      ( if $r.rev != ($r.transitions[-1].rev // -1) then "rev-not-last-transition" else empty end ),
      ( if ([$r.transitions[].rev] | . as $v
             | ($v[0] == 1) and all(range(1; $v | length); $v[.] == $v[. - 1] or $v[.] == $v[. - 1] + 1)) | not
        then "transition-revs-not-consecutive" else empty end ),
      ( if $r.result.source != null and $r.result.source == "reemit:" + $r.id then "result-source-names-self" else empty end ),
      ( if $r.artifact.target_at_arm != null and $r.artifact.target_after != null
             and $r.artifact.target_at_arm != $r.artifact.target_after and ($r.artifact.out_of_scope | length) == 0
        then "read-target-changed-unreported" else empty end )
    ];
JQ
)"

# ---------------------------------------------------------------- basics

die() {
  local code="$1"
  shift
  printf 'passdown-attempt: %s\n' "$*" >&2
  exit "$code"
}
warn() { printf 'passdown-attempt: warning: %s\n' "$*" >&2; }
now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }
NOW="$(now_utc)"

sha256_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -c1-64
  else
    shasum -a 256 | cut -c1-64
  fi
}
digest_file() { printf 'sha256:%s' "$(sha256_stdin <"$1")"; }
digest_stdin() { printf 'sha256:%s' "$(sha256_stdin)"; }

# Test-only fault injection: PASSDOWN_TEST_CRASH_AT=<point> kills the helper
# at that point, as a power loss would. Used by tests/attempt.sh (F23).
crash_point() {
  if [ "${PASSDOWN_TEST_CRASH_AT:-}" = "$1" ]; then
    kill -KILL $$
  fi
}

jq_lib() { # jq_lib <program> [jq options and files...] — jq with the schema library
  local program="$1"
  shift
  jq "$SCHEMA_LIB
$program" "$@"
}

ID_RE='^pd-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$'
HOLDING_REASONS=" needs_input blocked invalid_result reemit_wrote integration_failed "

# ---------------------------------------------------------------- processes

PS_OK=""
ps_ok() {
  if [ -z "$PS_OK" ]; then
    if [ -n "$(ps -o lstart= -p $$ 2>/dev/null || true)" ]; then PS_OK=1; else PS_OK=0; fi
  fi
  [ "$PS_OK" = 1 ]
}
proc_start() { ps -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//; s/ *$//' || true; }

pid_state() { # <pid> <recorded start or ""> -> alive | reused | gone
  local pid="$1" recorded="$2" current
  if ps_ok; then
    current="$(proc_start "$pid")"
    if [ -z "$current" ]; then
      echo gone
    elif [ -z "$recorded" ] || [ "$current" = "$recorded" ]; then
      echo alive
    else
      echo reused
    fi
  elif kill -0 "$pid" 2>/dev/null; then
    echo alive
  else
    echo gone
  fi
}

pgroup_count() { # <pgid> -> number of processes in the group, or "unknown"
  if ! ps_ok; then
    echo unknown
    return
  fi
  ps -A -o pgid= 2>/dev/null | awk -v g="$1" '$1 == g { n++ } END { print n + 0 }'
}

# ---------------------------------------------------------------- locks
#
# One primitive: a directory created with mkdir (atomic on local POSIX file
# systems), holding an `owner` file with the helper's pid and start time.
# Locks are held only inside one invocation; a dead holder's lock is broken
# under a separate `.break` lock so two breakers cannot both remove it.

HELD_LOCKS=()
SELF_START=""

release_all_locks() {
  local i
  i=${#HELD_LOCKS[@]}
  while [ "$i" -gt 0 ]; do
    i=$((i - 1))
    rm -f "${HELD_LOCKS[$i]}/owner"
    rmdir "${HELD_LOCKS[$i]}" 2>/dev/null || true
  done
  HELD_LOCKS=()
}
trap release_all_locks EXIT

lock_is_stale() { # <lockdir>
  local dir="$1" owner pid start
  owner="$(cat "$dir/owner" 2>/dev/null || true)"
  if [ -z "$owner" ]; then
    # Created but no owner written yet, or the writer died right after mkdir.
    [ -n "$(find "$dir" -maxdepth 0 -mmin +1 2>/dev/null)" ]
    return
  fi
  pid="${owner%% *}"
  start="${owner#* }"
  [ "$start" != "$owner" ] || start=""
  [ "$(pid_state "$pid" "$start")" != alive ]
}

lock_break() { # <lockdir>
  local dir="$1"
  if mkdir "$dir.break" 2>/dev/null; then
    if [ -d "$dir" ] && lock_is_stale "$dir"; then
      rm -rf "$dir"
    fi
    rmdir "$dir.break" 2>/dev/null || true
  elif [ -n "$(find "$dir.break" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
    rm -rf "$dir.break"
  fi
}

lock_acquire() { # <lockdir>
  local dir="$1" tries=0
  [ -n "$SELF_START" ] || SELF_START="$(proc_start $$)"
  while ! mkdir "$dir" 2>/dev/null; do
    [ -d "$(dirname "$dir")" ] || die $E_STATE "cannot lock $dir: parent directory is missing"
    if lock_is_stale "$dir"; then
      lock_break "$dir"
      continue
    fi
    tries=$((tries + 1))
    [ "$tries" -le 200 ] || die $E_REV "timed out after 10s waiting for lock $dir"
    sleep 0.05
  done
  printf '%s %s\n' "$$" "$SELF_START" >"$dir/owner"
  HELD_LOCKS+=("$dir")
}

lock_release() { # <lockdir>
  local dir="$1" i kept=()
  rm -f "$dir/owner"
  rmdir "$dir" 2>/dev/null || true
  for i in ${HELD_LOCKS[@]+"${HELD_LOCKS[@]}"}; do
    [ "$i" = "$dir" ] || kept+=("$i")
  done
  HELD_LOCKS=(${kept[@]+"${kept[@]}"})
}

lock_receipts() { # <id>... — receipt locks in ascending ID order
  local id
  for id in $(printf '%s\n' "$@" | LC_ALL=C sort -u); do
    lock_acquire "$STORE/$id/.lock"
  done
}

# ---------------------------------------------------------------- paths / git

abs_dir() { (cd "$1" 2>/dev/null && pwd -P); }
git_toplevel() {
  local top
  top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || return 1
  abs_dir "$top"
}
git_common_dir() {
  local d
  d="$(git -C "$1" rev-parse --git-common-dir 2>/dev/null)" || return 1
  (cd "$1" && cd "$d" && pwd -P)
}

resolve_store() { # [create]
  [ -n "$STORE" ] || STORE="${PASSDOWN_ATTEMPT_DIR:-}"
  if [ -z "$STORE" ]; then
    local common
    common="$(git_common_dir .)" || die $E_USAGE "not inside a git repository: pass --store <dir>"
    STORE="$common/passdown/attempts"
  fi
  if [ "${1:-}" = create ]; then
    mkdir -p "$STORE" || die $E_USAGE "cannot create attempt store $STORE"
  fi
  if [ -d "$STORE" ]; then
    STORE="$(abs_dir "$STORE")"
    warn_network_fs "$STORE"
  fi
}

warn_network_fs() {
  local fs=""
  if [ "$(uname -s)" = Linux ]; then
    fs="$(stat -f -c %T "$1" 2>/dev/null || true)"
  fi
  case "$fs" in
    nfs* | cifs | smb* | fuse.sshfs | 9p)
      warn "$1 is on a network file system ($fs): mkdir locks are outside the v0.5 guarantee"
      ;;
  esac
}

require_id() {
  [[ "$1" =~ $ID_RE ]] || die $E_USAGE "not an attempt id: $1"
  [ -f "$STORE/$1/receipt.json" ] || die $E_USAGE "no attempt $1 in $STORE"
}
receipt_of() { cat "$STORE/$1/receipt.json"; }
rfield() { jq -r "$2" "$STORE/$1/receipt.json"; }

write_atomic() { # <file> < content
  local tmp="$1.tmp.$$"
  cat >"$tmp" && mv -f "$tmp" "$1"
}

# ---------------------------------------------------------------- schemas

schema_path() {
  local d
  for d in "$HELPER_DIR/../schemas/protocol" "$HELPER_DIR/../schemas"; do
    if [ -f "$d/$1.v1.schema.json" ]; then
      printf '%s\n' "$d/$1.v1.schema.json"
      return
    fi
  done
  die $E_USAGE "cannot find $1.v1.schema.json next to the helper ($HELPER_DIR)"
}

receipt_problems() { # <receipt json> -> one line per problem, nothing if valid
  jq_lib '(sv_errors($s[0]) | map("schema: \(.keyword) at \(if .path == "" then "/" else .path end)\(if .missing then " (missing \(.missing))" elif .extra then " (unknown \(.extra))" else "" end)")[]),
          (receipt_semantic_errors | map("invariant: " + .)[])' \
    -r --slurpfile s "$(schema_path receipt)" <<<"$1"
}

guard_receipt() { # <receipt json> [exit code]
  local problems
  problems="$(receipt_problems "$1")"
  [ -z "$problems" ] || die "${2:-$E_STATE}" "refusing to write a receipt that breaks the v1 contract:
$problems"
}

# ---------------------------------------------------------------- plans

# task_block <plan> <task id> [raw] — the task's checkbox line and its
# indented body up to the next task or heading. Normalized (design 12.1)
# unless "raw": checkbox state fixed, Dispatched lines and the dispatch tag
# removed, trailing whitespace stripped, LF endings. Exit 3 if the task is
# missing, 4 if its id is not unique.
task_block() {
  awk -v id="$2" -v raw="${3:-}" '
    function ind(s) { match(s, /^[ \t]*/); return RLENGTH }
    { sub(/\r$/, "") }
    inb && ($0 ~ /^#/ || ($0 !~ /^[ \t]*$/ && ind($0) <= tind)) { inb = 0 }
    !inb && $0 ~ /^[ \t]*- \[[ xX]\][ \t]/ {
      rest = $0
      sub(/^[ \t]*- \[[ xX]\][ \t]+/, "", rest)
      split(rest, w, /[ \t]+/)
      if (w[1] == id) { found++; inb = 1; tind = ind($0) }
    }
    inb && found == 1 { blk[n++] = $0 }
    END {
      if (found == 0) exit 3
      if (found > 1) exit 4
      m = 0
      for (i = 0; i < n; i++) {
        l = blk[i]
        if (raw == "") {
          if (i == 0) sub(/- \[[ xX]\]/, "- [ ]", l)
          if (l ~ /^[ \t]*- Dispatched:/) continue
          gsub(/[ \t]*\[dispatch:[^]]*\]/, "", l)
          sub(/[ \t]+$/, "", l)
        }
        out[m++] = l
      }
      while (m > 0 && out[m - 1] ~ /^[ \t]*$/) m--
      for (i = 0; i < m; i++) print out[i]
    }' "$1"
}

task_block_or_die() { # <plan> <id> [raw]
  local out rc=0
  out="$(task_block "$@")" || rc=$?
  case "$rc" in
    0) printf '%s\n' "$out" ;;
    3) die $E_STATE "task $2 not found in $1" ;;
    4) die $E_STATE "task id $2 is not unique in $1" ;;
    *) die $E_STATE "cannot read $1" ;;
  esac
}

task_digest() { task_block_or_die "$1" "$2" | digest_stdin; }

task_paths_json() { # <normalized block on stdin> -> JSON array from "- Paths:"
  awk '/^[ \t]*- Paths:/ { sub(/^[ \t]*- Paths:[ \t]*/, ""); print; exit }' |
    jq -R -s -c 'split(",") | map(gsub("`"; "") | gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))'
}

# Canonical plan digest (design 12.2): the plan with every host-owned element
# normalized — Dispatched lines removed, checkbox states fixed — except the
# attempt's own checkbox, which the worker must not touch. The attempt's own
# task text is left out: an edit there makes the task digest stale, which is
# the finding for it whoever made the edit (F3, F6).
plan_digest() { # <plan> <task id>
  awk -v id="$2" '
    function ind(s) { match(s, /^[ \t]*/); return RLENGTH }
    { sub(/\r$/, ""); sub(/[ \t]+$/, "") }
    own && ($0 ~ /^#/ || ($0 != "" && ind($0) <= tind)) { own = 0 }
    own { next }
    /^[ \t]*- Dispatched:/ { next }
    /^[ \t]*- \[[ xX]\][ \t]/ {
      rest = $0
      sub(/^[ \t]*- \[[ xX]\][ \t]+/, "", rest)
      split(rest, w, /[ \t]+/)
      if (w[1] == id) {
        own = 1; tind = ind($0)
        state = $0; sub(/^[ \t]*- \[/, "", state); state = substr(state, 1, 1)
        print "- [" state "] " id " (own task; text covered by the task digest)"
        next
      }
      sub(/- \[[ xX]\]/, "- [ ]")
    }
    { print }' "$1" | digest_stdin
}

# ---------------------------------------------------------------- executor cards

find_card() { # <name> <version> -> path of the card file, or nothing
  local name="$1" version="$2" dir file dirs=()
  local IFS=:
  for dir in $CARD_DIRS; do [ -n "$dir" ] && dirs+=("$dir"); done
  unset IFS
  dirs+=("$HELPER_DIR/../references/executors"
    "$HELPER_DIR/../plugins/passdown/skills/passdown-dispatch/references/executors")
  for dir in "${dirs[@]}"; do
    file="$dir/$name.md"
    [ -f "$file" ] || continue
    if [ "$(card_json "$file" | jq -r '.card_version // ""')" = "$version" ]; then
      printf '%s\n' "$file"
      return
    fi
  done
}

card_json() { # <card.md> -> flat JSON of its YAML frontmatter (two levels)
  awk '
    NR == 1 { if ($0 != "---") exit; fm = 1; next }
    fm && $0 == "---" { exit }
    fm {
      line = $0
      sub(/\r$/, "", line)
      if (line ~ /^[A-Za-z_]+:/) {
        sec = line; sub(/:.*/, "", sec); key = sec
      } else if (line ~ /^  [A-Za-z_]+:/) {
        k = line; sub(/^  /, "", k); sub(/:.*/, "", k); key = sec "." k
      } else next
      val = line
      sub(/^[^:]*:[ \t]*/, "", val)
      sub(/[ \t]+#.*$/, "", val)
      sub(/[ \t]+$/, "", val)
      if (val ~ /^".*"$/ || val ~ /^\047.*\047$/) val = substr(val, 2, length(val) - 2)
      printf "%s\t%s\n", key, val
    }' "$1" | jq -R -n -c '[inputs | split("\t") | {key: .[0], value: (.[1:] | join("\t"))}] | from_entries'
}

card_value() { # <id> <key> <default>
  local f="$STORE/$1/card.json"
  if [ -f "$f" ]; then
    jq -r --arg k "$2" --arg d "$3" '.[$k] // $d | if . == "" then $d else . end' "$f"
  else
    printf '%s\n' "$3"
  fi
}
cap() { card_value "$1" "capabilities.$2" unverified; }

# ---------------------------------------------------------------- artifacts

file_hash() { # <dir> <relative path>
  if [ -d "$1/$2" ] && [ ! -L "$1/$2" ]; then
    printf 'dir:%s\n' "$(git -C "$1/$2" rev-parse HEAD 2>/dev/null || echo none)"
  elif [ -e "$1/$2" ] || [ -L "$1/$2" ]; then
    git -C "$1" hash-object -- "$2"
  else
    echo deleted
  fi
}

changes_json() { # <location> <base commit> -> [{status, path, hash}]
  local loc="$1" base="$2" st p
  {
    git -C "$loc" diff --no-renames --name-status -z "$base" -- |
      while IFS= read -r -d '' st && IFS= read -r -d '' p; do
        printf '%s\0%s\0%s\0' "$st" "$p" "$(file_hash "$loc" "$p")"
      done
    git -C "$loc" ls-files --others --exclude-standard -z |
      while IFS= read -r -d '' p; do
        printf 'A\0%s\0%s\0' "$p" "$(file_hash "$loc" "$p")"
      done
  } | jq -R -s -c 'split("\u0000") | .[:-1] | [range(0; length; 3) as $i | {status: .[$i], path: .[$i + 1], hash: .[$i + 2]}]'
}

chain_root_dir() { # <id> -> attempt dir holding the chain's baseline.json
  printf '%s/%s\n' "$STORE" "$(rfield "$1" .chain_root)"
}

# compute_artifact <id> -> JSON {digest, entries, changed, out_of_scope,
# overlaps_baseline, plan_touched}: the chain artifact in the attempt's
# location against the chain root's baseline (design 12.2).
compute_artifact() {
  local id="$1" r root_dir baseline loc base cur now_hashes plan_rel plan_abs plan_now p
  r="$(receipt_of "$id")"
  root_dir="$(chain_root_dir "$id")"
  baseline="$root_dir/baseline.json"
  [ -f "$baseline" ] || die $E_STATE "chain baseline missing: $baseline"
  if [ "$(jq -r .kind <<<"$r")" = read ]; then
    loc="$(jq -r .place.repo <<<"$r")"
  else
    loc="$(jq -r .place.location <<<"$r")"
  fi
  [ -d "$loc" ] || die $E_STATE "attempt location does not exist: $loc"
  base="$(jq -r .base_commit "$baseline")"
  git -C "$loc" cat-file -e "$base^{commit}" 2>/dev/null || die $E_STATE "base commit $base is not in $loc"
  cur="$(changes_json "$loc" "$base")" || die $E_STATE "cannot diff $loc against $base"
  now_hashes="$(jq -r '.dirty[].path' "$baseline" | while IFS= read -r p; do
    printf '%s\0%s\0' "$p" "$(file_hash "$loc" "$p")"
  done | jq -R -s -c 'split("\u0000") | .[:-1] | [range(0; length; 2) as $i | {key: .[$i], value: .[$i + 1]}] | from_entries')"
  plan_abs="$(jq -r .plan.path "$baseline")"
  plan_rel=""
  if [ "$(jq -r .plan.in_location "$baseline")" = true ]; then
    plan_rel="$(jq -r .plan.rel "$baseline")"
  fi
  plan_now="$(plan_digest "$plan_abs" "$(jq -r '.task.ref | sub(".*#"; "")' <<<"$r")" 2>/dev/null || echo missing)"
  local art
  art="$(jq -c -n --argjson cur "$cur" --slurpfile b "$baseline" --argjson now "$now_hashes" \
    --argjson r "$r" --arg plan_rel "$plan_rel" --arg plan_now "$plan_now" --arg plan_abs "$plan_abs" --arg loc "$loc" '
    ($b[0].dirty | map({key: .path, value: .}) | from_entries) as $bd
    | ($cur | map({key: .path, value: .}) | from_entries) as $cd
    | ( [ $cur[]
          | select(($bd[.path] // null) as $d | $d == null or $d.hash != .hash or $d.status != .status)
          | .path as $p | . + {overlaps: ($bd | has($p))} ]
        + [ $b[0].dirty[] | select(.path as $p | $cd | has($p) | not)
            | {status: "reverted", path, hash: $now[.path], overlaps: true} ] ) as $all
    # The plan is host-owned: never part of the submission, judged only by
    # plan_touched. In a worktree it is the worker copy; in the planner
    # checkout itself it is the canonical plan.
    | ($plan_rel != "" and ($all | any(.path == $plan_rel))
        and ($loc + "/" + $plan_rel) != $plan_abs) as $copy_touched
    | ($all | map(select(.path != $plan_rel)) | sort_by(.path)) as $entries
    | ($r.task.paths) as $scope
    | {
        entries: $entries,
        changed: ($entries | length),
        out_of_scope: [ $entries[].path
          | select($r.kind == "read" or (. as $p | $scope | any(. as $s
              | $p == $s or (($s | endswith("/")) and ($p | startswith($s))) or ($p | startswith($s + "/"))) | not)) ],
        overlaps_baseline: [ $entries[] | select(.overlaps) | .path ],
        plan_touched: ($copy_touched or $plan_now != $b[0].plan.digest),
        lines: ($entries | map({path, status, hash} | tojson) | join("\n") | if . == "" then "" else . + "\n" end)
      }')"
  jq -c --arg d "$(jq -j .lines <<<"$art" | digest_stdin)" 'del(.lines) | .digest = $d' <<<"$art"
}

# ---------------------------------------------------------------- receipts

TRACKED_FIELDS='[["execution","observation"],["execution","stop_evidence"],["execution","cancel_requested_at"],
  ["execution","reconciled_at"],["handle","pid"],["handle","provider_session"],["handle","parent_exited_at"],
  ["result","status"],["artifact","at_arm"],["artifact","digest"],["verdict","acceptance"],
  ["verdict","projected_at"],["claim","state"]]'

# mutate <id> <rev|-> <note> <jq filter> [jq args...]
# A locked compare-and-write step: the caller already holds the receipt lock
# (and the claim mutex first, when claims are involved). Re-reads the
# receipt, compares rev, applies the filter, appends the transitions of the
# tracked fields, validates the result against the contract and renames it
# into place.
mutate() {
  local id="$1" rev="$2" note="$3" filter="$4" file old current new err
  shift 4
  file="$STORE/$id/receipt.json"
  old="$(cat "$file")"
  current="$(jq -r .rev <<<"$old")"
  if [ "$rev" != - ] && [ "$rev" != "$current" ]; then
    die $E_REV "rev conflict on $id: planned against rev $rev, receipt is at rev $current (re-read it)"
  fi
  err="$(mktemp)"
  if ! new="$(jq -c --arg now "$NOW" "$@" "$filter" <<<"$old" 2>"$err")"; then
    local msg
    msg="$(sed 's/^jq: error ([^)]*): //' "$err")"
    rm -f "$err"
    die $E_STATE "$id: $msg"
  fi
  rm -f "$err"
  new="$(jq -c --argjson old "$old" --arg now "$NOW" --arg note "$note" --argjson tracked "$TRACKED_FIELDS" '
    . as $new | ($old.rev + 1) as $r
    | [ $tracked[] as $p
        | ($old | getpath($p)) as $a | ($new | getpath($p)) as $b
        | select($a != $b)
        | {rev: $r, field: ($p | join(".")), from: $a, to: $b, at: $now, note: $note} ] as $t
    | $new | .rev = $r
    | .transitions = $old.transitions
        + (if $t == [] then [{rev: $r, field: "receipt", from: null, to: null, at: $now, note: $note}] else $t end)' <<<"$new")"
  guard_receipt "$new"
  # A claim release commits in the claim namespace only once the receipt
  # that records it is known to be valid (design 10.4 release order).
  if [ "${#MUTATE_RELEASE[@]}" -gt 0 ]; then
    release_claim_files "${MUTATE_RELEASE[@]}"
    MUTATE_RELEASE=()
  fi
  jq . <<<"$new" | write_atomic "$file"
}
MUTATE_RELEASE=()

check_rev() { # <id> <rev> — early stale-client check (mutate re-checks under the lock)
  local current
  current="$(rfield "$1" .rev)"
  [ "$2" = "$current" ] || die $E_REV "rev conflict on $1: planned against rev $2, receipt is at rev $current (re-read it)"
}

is_resolved() { # <id>
  jq -e '.execution.observation == "stopped" and .verdict.acceptance != "pending"
    and (.verdict.acceptance != "accepted" or .verdict.projected_at != null)' \
    "$STORE/$1/receipt.json" >/dev/null
}

holding_reason() { case "$HOLDING_REASONS" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# ---------------------------------------------------------------- writer claims

claims_ns_of_repo() {
  local common
  common="$(git_common_dir "$1")" || die $E_STATE "not a git repository, cannot hold a writer claim: $1"
  printf '%s/passdown/claims\n' "$common"
}
claim_file() { # <ns> <key>
  case "$2" in
    repo) printf '%s/repo.json\n' "$1" ;;
    loc:*) printf '%s/loc/%s.json\n' "$1" "${2#loc:}" ;;
    *) die $E_GUARD "not a claimable key: $2 (claims are repository-local: repo or loc:<hash>)" ;;
  esac
}
live_claims() { # <ns> -> claim files, one per line
  local f
  for f in "$1/repo.json" "$1"/loc/*.json; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done
  return 0
}

mutex_acquire() { # <ns> — take the claim mutex, then repair projections
  mkdir -p "$1/loc" "$1/history" || die $E_STATE "cannot create claim namespace $1"
  lock_acquire "$1/.mutex"
  claims_repair "$1"
}

# Projection repair (design 10.4): the claim file is the authority.
claims_repair() {
  local ns="$1" f holder store acquired pred named="" id state obs n hist
  while IFS= read -r f <&3; do
    holder="$(jq -r .holder "$f")"
    named="$named $holder "
    store="$(jq -r .store "$f")"
    [ "$store" = "$STORE" ] && [ -f "$STORE/$holder/receipt.json" ] || continue
    acquired="$(jq -r --arg h "$holder" '[.history[] | select(.to == $h) | .at] | last // empty' "$f")"
    [ -n "$acquired" ] || acquired="$(jq -r .acquired_at "$f")"
    lock_receipts "$holder"
    if [ "$(rfield "$holder" .claim.state)" = requested ]; then
      mutate "$holder" - "repair: claim file names this attempt" \
        '.claim.state = "held" | .claim.acquired_at = $acq' --arg acq "$acquired"
    fi
    pred="$(rfield "$holder" '.continues // ""')"
    lock_release "$STORE/$holder/.lock"
    if [ -n "$pred" ] && [ -f "$STORE/$pred/receipt.json" ] &&
      [ "$(rfield "$pred" .claim.state)" = held ] &&
      [ "$(rfield "$pred" .claim.namespace)" = "$ns" ]; then
      lock_receipts "$pred"
      mutate "$pred" - "repair: claim transferred to $holder" \
        '.claim.state = "transferred" | .claim.transferred_to = $to' --arg to "$holder"
      lock_release "$STORE/$pred/.lock"
    fi
  done 3< <(live_claims "$ns")
  for id in $(for f in "$STORE"/pd-*/receipt.json; do
    [ -f "$f" ] && jq -r --arg ns "$ns" 'select(.claim != null and .claim.namespace == $ns
      and (.claim.state == "requested" or .claim.state == "held")) | .id' "$f"
  done); do
    case "$named" in *" $id "*) continue ;; esac
    lock_receipts "$id"
    state="$(rfield "$id" .claim.state)"
    obs="$(rfield "$id" .execution.observation)"
    hist=""
    for n in "$ns"/history/"$id".*.json; do [ -f "$n" ] && hist="$n"; done
    if [ "$state" = requested ] && [ "$obs" = prepared ]; then
      mutate "$id" - "repair: claim never committed" \
        '.claim.state = "released" | .claim.released_at = $now | .claim.release_basis = "never-committed"'
    elif [ "$state" = held ] && [ -n "$hist" ]; then
      mutate "$id" - "repair: claim released (history)" \
        '.claim.state = "released" | .claim.released_at = $at | .claim.release_basis = $basis' \
        --arg at "$(jq -r .released_at "$hist")" --arg basis "$(jq -r .release_basis "$hist")"
    else
      warn "$id: receipt says claim $state but no claim file or history names it (removed outside the helper?) — needs owner attention"
    fi
    lock_release "$STORE/$id/.lock"
  done
}

keys_free() { # <ns> <key> -> prints the blocking claim file, returns 1 when taken
  local ns="$1" key="$2" f
  if [ -f "$ns/repo.json" ]; then
    printf '%s\n' "$ns/repo.json"
    return 1
  fi
  if [ "$key" = repo ]; then
    f="$(live_claims "$ns" | head -n 1)"
  else
    f="$(claim_file "$ns" "$key")"
    [ -f "$f" ] || f=""
  fi
  if [ -n "$f" ]; then
    printf '%s\n' "$f"
    return 1
  fi
}

write_claim_file() { # <file> <json>
  mkdir -p "$(dirname "$1")"
  printf '%s\n' "$2" | jq . | write_atomic "$1"
}

# release_claim_files <ns> <key> <id> <basis> — history copy first, then the
# live file is removed: that removal is the commit point.
release_claim_files() {
  local ns="$1" key="$2" id="$3" basis="$4" live n=1
  live="$(claim_file "$ns" "$key")"
  [ -f "$live" ] || return 0
  [ "$(jq -r .holder "$live")" = "$id" ] || die $E_STATE "claim $key names $(jq -r .holder "$live"), not $id"
  while [ -e "$ns/history/$id.$n.json" ]; do n=$((n + 1)); done
  jq --arg now "$NOW" --arg basis "$basis" '.released_at = $now | .release_basis = $basis' "$live" |
    write_atomic "$ns/history/$id.$n.json"
  crash_point release:after-history
  rm -f "$live"
  crash_point release:after-claim-removed
}

claim_release_filter='if .claim != null and .claim.state == "held"
  then .claim.state = "released" | .claim.released_at = $now | .claim.release_basis = $basis else . end'

# ---------------------------------------------------------------- command: new

cmd_new() {
  local task_ref="" kind="" tier="" reason_code="" reason="" executor="" card="" invocation=""
  local host_agent="${PASSDOWN_HOST_AGENT:-}" session="" planner="" place_repo="" base_ref="HEAD"
  local isolation="" location="" worktree_dir="" profile="" profile_keys="loc" continues="" guard=""
  local answer="" inputs=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task-ref) task_ref="$2"; shift 2 ;;
      --kind) kind="$2"; shift 2 ;;
      --tier) tier="$2"; shift 2 ;;
      --reason-code) reason_code="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      --executor) executor="$2"; shift 2 ;;
      --card) card="$2"; shift 2 ;;
      --invocation) invocation="$2"; shift 2 ;;
      --host) host_agent="$2"; shift 2 ;;
      --session) session="$2"; shift 2 ;;
      --planner-repo) planner="$2"; shift 2 ;;
      --place-repo) place_repo="$2"; shift 2 ;;
      --base-ref) base_ref="$2"; shift 2 ;;
      --isolation) isolation="$2"; shift 2 ;;
      --location) location="$2"; shift 2 ;;
      --worktree-dir) worktree_dir="$2"; shift 2 ;;
      --profile) profile="$2"; shift 2 ;;
      --profile-keys) profile_keys="$2"; shift 2 ;;
      --continues) continues="$2"; shift 2 ;;
      --input) inputs+=("$2"); shift 2 ;;
      --answer) answer="$2"; shift 2 ;;
      --mutation-guard) guard="$2"; shift 2 ;;
      *) die $E_USAGE "new: unknown option $1" ;;
    esac
  done
  [ -n "$task_ref" ] && [ -n "$kind" ] && [ -n "$tier" ] && [ -n "$reason_code" ] && [ -n "$reason" ] &&
    [ -n "$executor" ] && [ -n "$host_agent" ] ||
    die $E_USAGE "new: --task-ref, --kind, --tier, --reason-code, --reason, --executor and --host are required"

  # Depth guard (I-18): a worker Passdown launched never starts another
  # external attempt.
  if [ "$tier" = external ] && [ -n "${PASSDOWN_ATTEMPT:-}" ]; then
    die $E_GUARD "depth guard: this process runs inside attempt $PASSDOWN_ATTEMPT; external dispatch from a worker is refused"
  fi

  resolve_store create

  # Chained attempts inherit task, place and baseline from the predecessor.
  local pred="" pred_json=""
  if [ -n "$continues" ]; then
    require_id "$continues"
    pred="$continues"
    pred_json="$(receipt_of "$pred")"
    [ "$(jq -r .task.ref <<<"$pred_json")" = "$task_ref" ] ||
      die $E_GUARD "continuation guard: $pred is for task $(jq -r .task.ref <<<"$pred_json"), not $task_ref"
    [ "$kind" != read ] || die $E_USAGE "a read attempt cannot continue another attempt"
    place_repo="$(jq -r .place.repo <<<"$pred_json")"
    location="$(jq -r .place.location <<<"$pred_json")"
    isolation="$(jq -r .place.isolation <<<"$pred_json")"
    profile="$(jq -r '.place.profile // ""' <<<"$pred_json")"
    planner="$(jq -r .task.planner_repo <<<"$pred_json")"
  else
    [ "$kind" != reemit ] && [ "$kind" != salvage ] || die $E_USAGE "new --kind $kind requires --continues"
  fi

  [ -n "$planner" ] || planner="$(git_toplevel .)" || die $E_USAGE "new: not in a git repository; pass --planner-repo"
  planner="$(abs_dir "$planner")" || die $E_USAGE "planner repo not found"
  [ -n "$place_repo" ] || die $E_USAGE "new: --place-repo is required"
  [ -n "$isolation" ] || die $E_USAGE "new: --isolation is required"
  place_repo="$(git_toplevel "$place_repo")" || die $E_STATE "target is not a git repository, so it cannot be claimed or receive delegated writes: $place_repo"

  local plan_rel="${task_ref%%#*}" task_id="${task_ref#*#}" plan
  [ "$plan_rel" != "$task_ref" ] && [ -n "$task_id" ] || die $E_USAGE "--task-ref must be <plan path>#<task id>"
  plan="$planner/$plan_rel"
  [ -f "$plan" ] || die $E_USAGE "plan not found: $plan"
  local block task_digest paths_json
  block="$(task_block_or_die "$plan" "$task_id")"
  task_digest="$(printf '%s\n' "$block" | digest_stdin)"
  paths_json="$(printf '%s\n' "$block" | task_paths_json)"
  if [ -n "$pred" ] && [ "$(jq -r .task.digest <<<"$pred_json")" != "$task_digest" ]; then
    die $E_GUARD "continuation guard: task $task_ref changed since $pred; start a new chain against the new revision"
  fi

  local base_commit
  if [ -n "$pred" ]; then
    base_commit="$(jq -r .place.base_commit <<<"$pred_json")"
    base_ref="$(jq -r '.place.base_ref // ""' <<<"$pred_json")"
  else
    base_commit="$(git -C "$place_repo" rev-parse --verify --quiet "$base_ref^{commit}")" ||
      die $E_USAGE "cannot resolve --base-ref $base_ref in $place_repo"
  fi

  # Allocate the attempt ID: the mkdir is the uniqueness check.
  local id="" try=0
  while [ "$try" -lt 5 ]; do
    id="pd-$(date -u +%Y%m%dT%H%M%SZ)-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
    if mkdir "$STORE/$id" 2>/dev/null; then break; fi
    id=""
    try=$((try + 1))
  done
  [ -n "$id" ] || die $E_STATE "could not allocate an attempt id in $STORE"
  local adir="$STORE/$id"
  NEW_ADIR="$adir"
  NEW_OK=0
  trap 'release_all_locks; if [ -n "${NEW_ADIR:-}" ] && [ "${NEW_OK:-0}" != 1 ]; then rm -rf "$NEW_ADIR"; fi' EXIT

  if [ -z "$pred" ]; then
    case "$isolation" in
      current-checkout) [ -n "$location" ] || location="$place_repo" ;;
      worktree)
        [ -n "$location" ] || {
          [ -n "$worktree_dir" ] || die $E_USAGE "--isolation worktree needs --worktree-dir (worktree_dir config) or --location"
          worktree_dir="$(abs_dir "$worktree_dir")" || die $E_USAGE "worktree dir does not exist"
          location="$worktree_dir/$id"
        }
        ;;
      read-only) [ -n "$location" ] || location="$place_repo" ;;
      *) die $E_USAGE "--isolation must be current-checkout, worktree or read-only" ;;
    esac
    if [ -d "$location" ]; then location="$(abs_dir "$location")"; fi
  fi
  case "$location" in /*) ;; *) die $E_USAGE "location must be an absolute path: $location" ;; esac

  # I-15: the store never lives inside the attempt's own working tree.
  local loc_common=""
  [ -d "$location" ] && loc_common="$(git_common_dir "$location" 2>/dev/null || true)"
  case "$STORE/" in
    "$location/"*)
      case "$STORE/" in
        "$loc_common/"*) ;;
        *) die $E_STATE "attempt store $STORE is inside the attempt location $location" ;;
      esac
      ;;
  esac

  # Executor card snapshot: capabilities are read from this copy for the
  # whole attempt, so a later card edit cannot change its safety rules.
  if [ -n "$card" ]; then
    [[ "$card" =~ ^[a-z0-9][a-z0-9-]*@[1-9][0-9]*$ ]] || die $E_USAGE "--card must be <name>@<version>"
    local card_path
    card_path="$(find_card "${card%@*}" "${card#*@}")"
    if [ -n "$card_path" ]; then
      cp "$card_path" "$adir/card.md"
      card_json "$card_path" >"$adir/card.json"
    else
      warn "executor card $card not found; every capability is treated as unverified"
    fi
  fi

  # Read attempts: claim-free only with an enforced, card-verified guard.
  local needs_claim=1
  if [ "$kind" = read ]; then
    [ "$isolation" = read-only ] || die $E_USAGE "a read attempt uses --isolation read-only"
    if [ -n "$guard" ]; then
      local capname
      case "$guard" in
        readonly:*) capname=read_only_mode ;;
        snapshot+sandbox) capname=sandbox_confined_writes ;;
        *) die $E_USAGE "--mutation-guard must be readonly:<mechanism> or snapshot+sandbox" ;;
      esac
      [ "$(cap "$id" "$capname")" = verified ] ||
        die $E_GUARD "read guard: executor card ${card:-none} does not mark $capname verified; drop --mutation-guard to take the writer claim instead"
      needs_claim=0
    fi
  else
    [ -z "$guard" ] || die $E_USAGE "--mutation-guard applies to read attempts only"
  fi

  local key="repo" ns=""
  if [ -n "$profile" ]; then
    [ "$isolation" = worktree ] || die $E_USAGE "a concurrency profile needs --isolation worktree"
    local k
    for k in $(printf '%s' "$profile_keys" | tr ',' ' '); do
      [ "$k" = loc ] || die $E_GUARD "profile $profile declares key '$k': claims are repository-local, only loc is allowed"
    done
    key="loc:$(printf '%s' "$location" | sha256_stdin | cut -c1-16)"
  fi
  [ "$needs_claim" = 1 ] && ns="$(claims_ns_of_repo "$place_repo")"

  # Snapshots: task block, inputs, answer, baseline (chain root only).
  printf '%s\n' "$block" >"$adir/task.md"
  local inputs_json="[]" input ipath
  if [ -n "$answer" ]; then
    [ -f "$answer" ] || die $E_USAGE "answer file not found: $answer"
    cp "$answer" "$adir/answer.md"
    inputs+=("$adir/answer.md")
  fi
  for input in ${inputs[@]+"${inputs[@]}"}; do
    case "$input" in /*) ipath="$input" ;; *) ipath="$planner/$input" ;; esac
    [ -f "$ipath" ] || die $E_USAGE "input not found: $ipath"
    inputs_json="$(jq -c --arg p "$input" --arg d "$(digest_file "$ipath")" '. + [{path: $p, digest: $d}]' <<<"$inputs_json")"
  done
  if [ -n "$pred" ]; then
    jq -n --arg root "$(jq -r .chain_root <<<"$pred_json")" '{chain_root: $root}' >"$adir/baseline.json"
  else
    local dirty="[]" artifact_loc="$location" in_loc=false plan_common place_common
    [ "$kind" = read ] && artifact_loc="$place_repo"
    if [ -d "$artifact_loc" ]; then
      dirty="$(changes_json "$artifact_loc" "$base_commit")" || die $E_STATE "cannot snapshot $artifact_loc"
    fi
    plan_common="$(git_common_dir "$planner")"
    place_common="$(git_common_dir "$place_repo")"
    [ "$plan_common" = "$place_common" ] && in_loc=true
    jq -n --arg base "$base_commit" --arg loc "$artifact_loc" --argjson dirty "$dirty" \
      --arg plan "$plan" --arg rel "$plan_rel" --argjson in_loc "$in_loc" \
      --arg pd "$(plan_digest "$plan" "$task_id")" \
      '{base_commit: $base, location: $loc, dirty: $dirty,
        plan: {path: $plan, rel: $rel, in_location: $in_loc, digest: $pd}}' >"$adir/baseline.json"
  fi

  local reemit_expected="null"
  local receipt
  receipt="$(jq -n -c \
    --arg id "$id" --arg kind "$kind" --arg continues "$pred" \
    --arg root "$( [ -n "$pred" ] && jq -r .chain_root <<<"$pred_json" || printf '%s' "$id")" \
    --arg now "$NOW" --arg ref "$task_ref" --arg planner "$planner" --arg td "$task_digest" \
    --argjson inputs "$inputs_json" --argjson paths "$paths_json" \
    --arg agent "$host_agent" --arg session "$session" --arg ver "$PASSDOWN_VERSION" \
    --arg tier "$tier" --arg rc "$reason_code" --arg reason "$reason" \
    --arg exe "$executor" --arg card "$card" \
    --arg cver "$(card_value "$id" measured.cli_version "")" \
    --arg inv "$( [ -n "$invocation" ] && printf '%s' "$invocation" | digest_stdin || true)" \
    --arg repo "$place_repo" --arg bref "$base_ref" --arg bc "$base_commit" --arg iso "$isolation" \
    --arg profile "$profile" --arg loc "$location" --arg guard "$guard" \
    --arg ns "$ns" --arg key "$key" --argjson needs_claim "$needs_claim" '
    def nn: if . == "" then null else . end;
    {
      schema: "passdown.receipt/v1", id: $id, rev: 1, kind: $kind,
      continues: ($continues | nn), chain_root: $root, created_at: $now,
      task: {ref: $ref, planner_repo: $planner, digest: $td, inputs: $inputs, paths: $paths},
      host: {agent: $agent, session: ($session | nn), passdown_version: $ver},
      route: {tier: $tier, reason_code: $rc, reason: $reason},
      executor: {name: $exe, card: ($card | nn), version: ($cver | nn), engine: null, invocation_digest: ($inv | nn)},
      place: {repo: $repo, base_ref: ($bref | nn), base_commit: $bc, isolation: $iso,
              profile: ($profile | nn), location: $loc, mutation_guard: ($guard | nn)},
      handle: {pid: null, pid_started: null, pgid: null, provider_session: null, runner: null,
               containment: null, scope: null, parent_exited_at: null},
      claim: (if $needs_claim == 1 then {namespace: $ns, key: $key, state: "requested", acquired_at: null,
               transferred_to: null, released_at: null, release_basis: null} else null end),
      execution: {observation: "prepared", observed_at: $now, stop_evidence: null, attested_by: null,
                  exit: null, cancel_requested_at: null, cancel_method: null, reconciled_at: null},
      result: {ref: null, disposition: null, status: "none", diagnostics: [], source: null},
      artifact: {at_arm: null, digest: null, expected: null, changed: null, out_of_scope: [],
                 overlaps_baseline: [], plan_touched: null, inspections: [], target_at_arm: null, target_after: null},
      verdict: {acceptance: "pending", reason_code: null, reason: null, task_digest: null, artifact_digest: null,
                checks: [], integration: null, scope_override: null, at: null, projected_at: null},
      transitions: [ if $needs_claim == 1
        then {rev: 1, field: "claim.state", from: null, to: "requested", at: $now, note: "new"}
        else {rev: 1, field: "execution.observation", from: null, to: "prepared", at: $now, note: "new (claim-free read)"} end ]
    }')"

  if [ "$needs_claim" = 0 ]; then
    guard_receipt "$receipt" $E_USAGE
    jq . <<<"$receipt" | write_atomic "$adir/receipt.json"
    NEW_OK=1
    finish_new "$id"
    return
  fi

  mutex_acquire "$ns"

  # Continuation guards and the decision between transfer and acquire run
  # under the mutex, after projections are repaired.
  local transfer=0
  if [ -n "$pred" ]; then
    local pobs pverdict preason pstate pfile_holder=""
    pobs="$(rfield "$pred" .execution.observation)"
    pverdict="$(rfield "$pred" .verdict.acceptance)"
    preason="$(rfield "$pred" '.verdict.reason_code // ""')"
    pstate="$(rfield "$pred" '.claim.state // ""')"
    [ "$pobs" = stopped ] || die $E_GUARD "continuation guard: $pred is $pobs, not safely stopped"
    [ "$pverdict" = rejected ] || die $E_GUARD "continuation guard: $pred is $pverdict, not rejected"
    case "$kind" in
      write)
        [ "$preason" = needs_input ] || [ "$preason" = blocked ] ||
          die $E_GUARD "continuation guard: a write continuation follows needs_input or blocked, $pred was rejected $preason"
        ;;
      reemit)
        [ "$preason" = invalid_result ] || die $E_GUARD "re-emit guard: $pred was rejected $preason, not invalid_result"
        local link="$pred"
        while [ -n "$link" ]; do
          [ "$(rfield "$link" .kind)" != reemit ] || die $E_GUARD "re-emit guard: chain already contains re-emit $link (I-17)"
          link="$(rfield "$link" '.continues // ""')"
        done
        [ "$pstate" = held ] || die $E_GUARD "re-emit guard: $pred no longer holds the writer claim"
        reemit_expected="$(rfield "$pred" '.artifact.digest // ""')"
        [ -n "$reemit_expected" ] || die $E_GUARD "re-emit guard: $pred was never inspected"
        ;;
      salvage)
        case "$preason" in
          invalid_result | reemit_wrote | integration_failed) ;;
          *) die $E_GUARD "salvage guard: $pred was rejected $preason" ;;
        esac
        ;;
    esac
    [ -f "$(claim_file "$ns" "$key")" ] && pfile_holder="$(jq -r .holder "$(claim_file "$ns" "$key")")"
    if [ "$pfile_holder" = "$pred" ]; then
      transfer=1
    elif [ "$pstate" = held ]; then
      die $E_STATE "$pred says it holds claim $key but the claim file names ${pfile_holder:-nobody}; run validate"
    fi
  fi
  if [ "$reemit_expected" != null ]; then
    receipt="$(jq -c --arg e "$reemit_expected" '.artifact.expected = $e' <<<"$receipt")"
  fi

  guard_receipt "$receipt" $E_USAGE
  local cfile blocker
  cfile="$(claim_file "$ns" "$key")"

  if [ "$transfer" = 1 ]; then
    lock_receipts "$pred" "$id"
    jq . <<<"$receipt" | write_atomic "$adir/receipt.json"
    NEW_OK=1
    crash_point transfer:after-successor
    write_claim_file "$cfile" "$(jq -c --arg s "$id" --arg p "$pred" --arg now "$NOW" --arg store "$STORE" \
      '.holder = $s | .store = $store | .history += [{from: $p, to: $s, at: $now}]' "$cfile")"
    crash_point transfer:after-claim-file
    mutate "$id" - "new: claim transferred from $pred" '.claim.state = "held" | .claim.acquired_at = $now'
    crash_point transfer:after-successor-held
    mutate "$pred" - "claim transferred to $id" '.claim.state = "transferred" | .claim.transferred_to = $to' --arg to "$id"
  else
    lock_receipts "$id"
    jq . <<<"$receipt" | write_atomic "$adir/receipt.json"
    crash_point acquire:after-receipt
    if ! blocker="$(keys_free "$ns" "$key")"; then
      local bh bs
      bh="$(jq -r .holder "$blocker")"
      bs="$(jq -r .store "$blocker")"
      die $E_GUARD "writer claim on $place_repo is held by $bh (store $bs, key $(jq -r .key "$blocker")); no second writer starts while it is unresolved"
    fi
    NEW_OK=1
    write_claim_file "$cfile" "$(jq -n -c --arg key "$key" --arg h "$id" --arg store "$STORE" --arg profile "$profile" \
      --arg loc "$location" --arg now "$NOW" \
      '{schema: "passdown.claim/v1", key: $key, holder: $h, store: $store,
        profile: (if $profile == "" then null else $profile end), location: $loc,
        acquired_at: $now, history: [], released_at: null, release_basis: null}')"
    crash_point acquire:after-claim-file
    mutate "$id" - "new: claim acquired" '.claim.state = "held" | .claim.acquired_at = $now'
  fi
  finish_new "$id"
}

finish_new() {
  if [ "$JSON_OUT" = 1 ]; then
    jq -c '{id, rev, claim: (.claim.state // null)}' "$STORE/$1/receipt.json"
  else
    printf '%s\n' "$1"
  fi
}

# ---------------------------------------------------------------- lock helpers per command

# with_attempt_locks <id>: claim mutex first when the attempt has a claim,
# then the receipt lock.
with_attempt_locks() {
  local ns
  ns="$(rfield "$1" '.claim.namespace // ""')"
  if [ -n "$ns" ]; then
    mutex_acquire "$ns"
  fi
  lock_receipts "$1"
  # Projection repair done by this invocation is not a concurrent change:
  # a client that planned against the pre-repair rev is not stale.
  if [ -n "${REV:-}" ] && [[ "$REV" =~ ^[0-9]+$ ]]; then
    local current
    current="$(rfield "$1" .rev)"
    if [ "$current" != "$REV" ] && jq -e --argjson from "$REV" \
      '.rev > $from and all(.transitions[] | select(.rev > $from); (.note // "") | startswith("repair:"))' \
      "$STORE/$1/receipt.json" >/dev/null; then
      REV="$current"
    fi
  fi
}

parse_rev() { # sets REV from --rev, dies if missing
  [ -n "${REV:-}" ] || die $E_USAGE "$1: --rev <n> is required (the receipt revision this change was planned against)"
  [[ "$REV" =~ ^[0-9]+$ ]] || die $E_USAGE "--rev must be a number"
}

claim_names() { # <id> -> 0 if the live claim file for the attempt's key names it
  local ns key f
  ns="$(rfield "$1" '.claim.namespace // ""')"
  [ -n "$ns" ] || return 1
  key="$(rfield "$1" .claim.key)"
  f="$(claim_file "$ns" "$key")"
  [ -f "$f" ] && [ "$(jq -r .holder "$f")" = "$1" ]
}

# release_basis_if_resolved: decide whether the next mutate releases the
# claim — the attempt becomes resolved and its reason does not hold the
# claim (design 8.4). When it does, arms MUTATE_RELEASE for that mutate.
release_basis_if_resolved() { # <id> <observation after> <verdict after> <reason after> <projected after>
  local id="$1" obs="$2" verdict="$3" reason="$4" projected="$5"
  [ "$(rfield "$id" '.claim.state // ""')" = held ] || return 1
  [ "$obs" = stopped ] || return 1
  case "$verdict" in
    pending) return 1 ;;
    accepted) [ "$projected" = yes ] || return 1 ;;
    rejected) ! holding_reason "$reason" || return 1 ;;
  esac
  MUTATE_RELEASE=("$(rfield "$id" .claim.namespace)" "$(rfield "$id" .claim.key)" "$id" resolved)
  return 0
}

# ---------------------------------------------------------------- command: arm

cmd_arm() {
  local id="$1" prompt=""
  shift
  REV=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --rev) REV="$2"; shift 2 ;;
      --prompt) prompt="$2"; shift 2 ;;
      *) die $E_USAGE "arm: unknown option $1" ;;
    esac
  done
  parse_rev arm
  [ -n "$prompt" ] && [ -s "$prompt" ] || die $E_USAGE "arm: --prompt <file> (non-empty) is required"
  resolve_store
  require_id "$id"
  with_attempt_locks "$id"
  # Armability first (design 10.4): only the attempt the claim file names
  # can ever be launched, whatever its projection says.
  if [ "$(rfield "$id" '.claim // "" | type')" = object ]; then
    claim_names "$id" || die $E_GUARD "arm: the writer claim file does not name $id; it cannot be launched"
  fi
  check_rev "$id" "$REV"
  [ "$(rfield "$id" .execution.observation)" = prepared ] ||
    die $E_STATE "arm: $id is $(rfield "$id" .execution.observation), not prepared"
  [ ! -e "$STORE/$id/prompt.md" ] || die $E_STATE "arm: $id already has a prompt"
  local art at_arm expected
  art="$(compute_artifact "$id")"
  at_arm="$(jq -r .digest <<<"$art")"
  expected="$(rfield "$id" '.artifact.expected // ""')"
  if [ -n "$expected" ] && [ "$expected" != "$at_arm" ]; then
    die $E_STATE "arm: the location changed after the predecessor's inspection (expected $expected, found $at_arm); investigate before re-emitting"
  fi
  cp "$prompt" "$STORE/$id/prompt.md"
  mutate "$id" "$REV" arm '
    .execution.observation = "unknown" | .execution.observed_at = $now
    | .artifact.at_arm = $d
    | if .claim == null then .artifact.target_at_arm = $d else . end' --arg d "$at_arm"
  emit_rev "$id"
}

emit_rev() {
  if [ "$JSON_OUT" = 1 ]; then
    jq -c '{id, rev, observation: .execution.observation, verdict: .verdict.acceptance, claim: (.claim.state // null)}' "$STORE/$1/receipt.json"
  else
    rfield "$1" .rev
  fi
}

# ---------------------------------------------------------------- command: observe

probe_json() { # <id> -> facts, never writes
  local id="$1" pid started pgid scope containment pstate="none" pcount="none" scope_empty="none"
  pid="$(rfield "$id" '.handle.pid // ""')"
  started="$(rfield "$id" '.handle.pid_started // ""')"
  pgid="$(rfield "$id" '.handle.pgid // ""')"
  scope="$(rfield "$id" '.handle.scope // ""')"
  containment="$(rfield "$id" '.handle.containment // ""')"
  [ -z "$pid" ] || pstate="$(pid_state "$pid" "$started")"
  [ -z "$pgid" ] || pcount="$(pgroup_count "$pgid")"
  if [ -n "$scope" ]; then
    if [ -f "$scope/cgroup.procs" ]; then
      if [ -s "$scope/cgroup.procs" ]; then scope_empty=false; else scope_empty=true; fi
    else
      scope_empty=unknown
    fi
  fi
  jq -n -c --arg id "$id" --arg pid "$pid" --arg pstate "$pstate" --arg pcount "$pcount" \
    --arg scope_empty "$scope_empty" --arg containment "$containment" \
    --arg dmo "$(cap "$id" descendants_may_outlive)" '
    ($pstate == "gone" or $pstate == "reused") as $exited
    | {
        attempt: $id,
        pid: (if $pid == "" then null else ($pid | tonumber) end),
        process: $pstate,
        pgroup_members: (if $pcount == "none" or $pcount == "unknown" then null else ($pcount | tonumber) end),
        scope_empty: (if $scope_empty == "true" then true elif $scope_empty == "false" then false else null end),
        descendants_may_outlive: $dmo,
        safe_evidence: [
          (if $exited and $containment == "scope" and $scope_empty == "true" then "exit+scope-empty" else empty end),
          (if $exited and $pcount == "0" and $dmo == "unsupported" then "exit+pgroup-empty" else empty end),
          "owner-attested"
        ]
      }'
}

cmd_probe() {
  resolve_store
  require_id "$1"
  probe_json "$1"
}

cmd_observe() {
  local id="$1" to="$2" pid="" started="" pgid="" psession="" containment="" scope="" note=""
  local parent_exited=0 evidence="" exit_code="" signal="" attested=""
  shift 2 || die $E_USAGE "observe <id> running|unknown|stopped ..."
  REV=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --rev) REV="$2"; shift 2 ;;
      --pid) pid="$2"; shift 2 ;;
      --pid-started) started="$2"; shift 2 ;;
      --pgid) pgid="$2"; shift 2 ;;
      --provider-session) psession="$2"; shift 2 ;;
      --containment) containment="$2"; shift 2 ;;
      --scope) scope="$2"; shift 2 ;;
      --note) note="$2"; shift 2 ;;
      --parent-exited) parent_exited=1; shift ;;
      --evidence) evidence="$2"; shift 2 ;;
      --exit) exit_code="$2"; shift 2 ;;
      --signal) signal="$2"; shift 2 ;;
      --attested-by) attested="$2"; shift 2 ;;
      *) die $E_USAGE "observe: unknown option $1" ;;
    esac
  done
  parse_rev observe
  resolve_store
  require_id "$id"
  with_attempt_locks "$id"
  check_rev "$id" "$REV"
  local from
  from="$(rfield "$id" .execution.observation)"
  case "$to" in
    running)
      [ "$from" = unknown ] || die $E_STATE "observe running: $id is $from; only an armed (unknown) attempt can be observed running"
      if [ -n "$pid" ]; then
        [[ "$pid" =~ ^[0-9]+$ ]] || die $E_USAGE "--pid must be a number"
        [ -n "$started" ] || started="$(proc_start "$pid")"
        [ -n "$started" ] || die $E_STATE "observe running: process $pid is not alive and --pid-started was not given"
      fi
      [ -n "$pid" ] || [ -n "$psession" ] || die $E_USAGE "observe running needs --pid (bound to its start time) or --provider-session"
      [ -z "$pgid" ] || [[ "$pgid" =~ ^[0-9]+$ ]] || die $E_USAGE "--pgid must be a number"
      [ -n "$containment" ] || { [ -n "$pgid" ] && containment=pgroup; }
      case "$containment" in
        "" | pgroup) ;;
        scope) [ -n "$scope" ] || die $E_USAGE "--containment scope needs --scope <cgroup dir>" ;;
        *) die $E_USAGE "--containment must be pgroup or scope" ;;
      esac
      mutate "$id" "$REV" "observe running" '
        .execution.observation = "running" | .execution.observed_at = $now
        | .handle.pid = (if $pid == "" then null else ($pid | tonumber) end)
        | .handle.pid_started = (if $started == "" then null else $started end)
        | .handle.pgid = (if $pgid == "" then null else ($pgid | tonumber) end)
        | .handle.provider_session = (if $ps == "" then null else $ps end)
        | .handle.containment = (if $c == "" then null else $c end)
        | .handle.scope = (if $scope == "" then null else $scope end)' \
        --arg pid "$pid" --arg started "$started" --arg pgid "$pgid" --arg ps "$psession" \
        --arg c "$containment" --arg scope "$scope"
      ;;
    unknown)
      [ "$from" = running ] || [ "$from" = unknown ] ||
        die $E_STATE "observe unknown: $id is $from"
      [ -n "$note" ] || die $E_USAGE "observe unknown needs --note"
      mutate "$id" "$REV" "observe unknown: $note" '
        .execution.observation = "unknown" | .execution.observed_at = $now
        | if $pe == 1 and .handle.parent_exited_at == null then .handle.parent_exited_at = $now else . end' \
        --argjson pe "$parent_exited"
      ;;
    stopped)
      [ "$from" = running ] || [ "$from" = unknown ] ||
        die $E_STATE "observe stopped: $id is $from (use abandon for a prepared attempt)"
      local facts process
      facts="$(probe_json "$id")"
      process="$(jq -r .process <<<"$facts")"
      case "$evidence" in
        not-launched)
          [ "$from" = unknown ] && [ "$(rfield "$id" '.handle.pid // .handle.provider_session // ""')" = "" ] ||
            die $E_STATE "not-launched: $id has a process handle; it was launched"
          ;;
        owner-attested)
          [ -n "$attested" ] || die $E_USAGE "owner-attested evidence needs --attested-by <who>"
          [ "$process" != alive ] || die $E_STATE "owner-attested: process $(rfield "$id" .handle.pid) is still alive with the recorded start time"
          ;;
        exit+scope-empty | exit+pgroup-empty)
          jq -e --arg e "$evidence" '.safe_evidence | index($e)' <<<"$facts" >/dev/null ||
            die $E_STATE "$evidence is not safe stop evidence for $id: probe says $(jq -c 'del(.attempt)' <<<"$facts")"
          ;;
        "") die $E_USAGE "observe stopped needs --evidence" ;;
        *) die $E_STATE "'$evidence' is not stop evidence; a parent exit or a provider event cannot rule out a surviving writer (use observe unknown --parent-exited)" ;;
      esac
      [ "$evidence" = owner-attested ] || [ -z "$attested" ] || die $E_USAGE "--attested-by goes with --evidence owner-attested"
      local verdict reason basis_filter="."
      verdict="$(rfield "$id" .verdict.acceptance)"
      reason="$(rfield "$id" '.verdict.reason_code // ""')"
      if release_basis_if_resolved "$id" stopped "$verdict" "$reason" no; then
        basis_filter="$claim_release_filter"
      fi
      mutate "$id" "$REV" "observe stopped: $evidence" '
        .execution.observation = "stopped" | .execution.observed_at = $now
        | .execution.stop_evidence = $e
        | .execution.attested_by = (if $who == "" then null else $who end)
        | .execution.exit = (if $e == "not-launched" or ($code == "" and $sig == "") then null
            else {code: (if $code == "" then null else ($code | tonumber) end), signal: (if $sig == "" then null else $sig end)} end)
        | '"$basis_filter" \
        --arg e "$evidence" --arg who "$attested" --arg code "$exit_code" --arg sig "$signal" --arg basis resolved
      ;;
    *) die $E_USAGE "observe: state must be running, unknown or stopped" ;;
  esac
  emit_rev "$id"
}

# ---------------------------------------------------------------- command: abandon / cancel

cmd_abandon() {
  local id="$1" attested=""
  shift
  REV=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --rev) REV="$2"; shift 2 ;;
      --attested-by) attested="$2"; shift 2 ;;
      *) die $E_USAGE "abandon: unknown option $1" ;;
    esac
  done
  parse_rev abandon
  resolve_store
  require_id "$id"
  with_attempt_locks "$id"
  check_rev "$id" "$REV"
  [ "$(rfield "$id" .execution.observation)" = prepared ] ||
    die $E_STATE "abandon: $id is $(rfield "$id" .execution.observation); only a prepared attempt is abandoned"
  local loc changed=0 evidence=not-launched
  loc="$(rfield "$id" 'if .kind == "read" then .place.repo else .place.location end')"
  if [ -d "$loc" ]; then
    changed="$(compute_artifact "$id" | jq .changed)"
  fi
  if [ "$changed" != 0 ]; then
    [ -n "$attested" ] || die $E_STATE "abandon: $loc has $changed change(s) since the baseline, so a worker may have run without arm (class C2); have the owner confirm no writer remains and pass --attested-by <who>"
    evidence="owner-attested"
  fi
  local basis_filter="."
  if [ "$(rfield "$id" '.claim.state // ""')" = held ]; then
    MUTATE_RELEASE=("$(rfield "$id" .claim.namespace)" "$(rfield "$id" .claim.key)" "$id" resolved)
    basis_filter="$claim_release_filter"
  fi
  mutate "$id" "$REV" abandon '
    .execution.observation = "stopped" | .execution.observed_at = $now
    | .execution.stop_evidence = $e | .execution.attested_by = (if $who == "" then null else $who end)
    | if .verdict.acceptance == "pending" then
        .verdict.acceptance = "rejected" | .verdict.reason_code = "abandoned"
        | .verdict.reason = (if $e == "not-launched" then "never launched" else "abandoned before arm; writes attested by \($who)" end)
        | .verdict.at = $now
      else . end
    | '"$basis_filter" --arg e "$evidence" --arg who "$attested" --arg basis resolved
  emit_rev "$id"
}

cmd_cancel() {
  local id="$1" method=""
  shift
  REV=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --rev) REV="$2"; shift 2 ;;
      --method) method="$2"; shift 2 ;;
      *) die $E_USAGE "cancel: unknown option $1" ;;
    esac
  done
  parse_rev cancel
  [ -n "$method" ] || die $E_USAGE "cancel needs --method <how the host will stop it>"
  resolve_store
  require_id "$id"
  with_attempt_locks "$id"
  check_rev "$id" "$REV"
  case "$(rfield "$id" .execution.observation)" in
    running | unknown) ;;
    prepared) die $E_STATE "cancel: $id was never launched; use abandon" ;;
    *) die $E_STATE "cancel: $id is already stopped" ;;
  esac
  [ "$(rfield "$id" '.execution.cancel_requested_at // ""')" = "" ] || die $E_STATE "cancel: already requested for $id"
  mutate "$id" "$REV" "cancel requested: $method" \
    '.execution.cancel_requested_at = $now | .execution.cancel_method = $m' --arg m "$method"
  emit_rev "$id"
}

# ---------------------------------------------------------------- command: result

# validate_result_file <file> <attempt id or ""> -> JSON {valid, diagnostics, errors}
validate_result_file() {
  local file="$1" attempt="$2" size
  size="$(wc -c <"$file" | tr -d ' ')"
  if [ "$size" -gt 262144 ]; then
    jq -n -c --arg n "$size" '{valid: false, diagnostics: ["parse"], errors: [{path: "", keyword: "size", note: "\($n) bytes > 256 KiB"}]}'
    return
  fi
  if [ "$(jq -s 'length' "$file" 2>/dev/null || echo x)" != 1 ] || [ "$(jq -r type "$file")" != object ]; then
    jq -n -c '{valid: false, diagnostics: ["parse"], errors: [{path: "", keyword: "parse"}]}'
    return
  fi
  jq_lib '
    sv_errors($s[0]) as $e
    | ($e | map(result_diagnostic)) as $d
    | (if $attempt != "" and .attempt != $attempt then ["attempt-mismatch"] else [] end) as $ctx
    | ($d + $ctx | unique) as $all
    | {valid: ($all == []), diagnostics: $all, errors: $e}' \
    -c --slurpfile s "$(schema_path result)" --arg attempt "$attempt" "$file"
}

cmd_result() {
  local id="$1" payload=""
  shift
  REV=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --rev) REV="$2"; shift 2 ;;
      --payload) payload="$2"; shift 2 ;;
      *) die $E_USAGE "result: unknown option $1" ;;
    esac
  done
  parse_rev result
  [ -n "$payload" ] && [ -f "$payload" ] || die $E_USAGE "result needs --payload <file>"
  resolve_store
  require_id "$id"
  lock_receipts "$id"
  check_rev "$id" "$REV"
  [ "$(rfield "$id" .execution.observation)" != prepared ] || die $E_STATE "result: $id was never launched"
  [ "$(rfield "$id" .result.status)" != valid ] || die $E_STATE "result: $id already has a valid result"
  local verdict
  verdict="$(validate_result_file "$payload" "$id")"
  cp "$payload" "$STORE/$id/result.raw"
  if [ "$(jq -r .valid <<<"$verdict")" = true ]; then
    cp "$payload" "$STORE/$id/result.json"
    mutate "$id" "$REV" result '
      .result.ref = "result.json" | .result.status = "valid" | .result.diagnostics = []
      | .result.disposition = $d' --arg d "$(jq -r .disposition "$payload")"
  else
    rm -f "$STORE/$id/result.json"
    mutate "$id" "$REV" result '
      .result.ref = null | .result.status = "invalid" | .result.disposition = null
      | .result.diagnostics = $diag' --argjson diag "$(jq -c .diagnostics <<<"$verdict")"
  fi
  if [ "$JSON_OUT" = 1 ]; then
    jq -c --slurpfile r "$STORE/$id/receipt.json" '{id: $r[0].id, rev: $r[0].rev, valid, diagnostics}' <<<"$verdict"
  else
    rfield "$id" .rev
    [ "$(jq -r .valid <<<"$verdict")" = true ] || jq -r '.diagnostics | join(" ")' <<<"$verdict" >&2
  fi
  [ "$(jq -r .valid <<<"$verdict")" = true ] || exit $E_INVALID
}

# ---------------------------------------------------------------- command: inspect

cmd_inspect() {
  local id="$1"
  shift
  REV=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --rev) REV="$2"; shift 2 ;;
      *) die $E_USAGE "inspect: unknown option $1" ;;
    esac
  done
  parse_rev inspect
  resolve_store
  require_id "$id"
  lock_receipts "$id"
  check_rev "$id" "$REV"
  [ "$(rfield "$id" .execution.observation)" = stopped ] ||
    die $E_STATE "inspect: $id is $(rfield "$id" .execution.observation); inspection waits for a safe stop"
  local art
  art="$(compute_artifact "$id")"
  local record
  record="$(jq -c --arg now "$NOW" '{at: $now} + .' <<<"$art")"
  if [ -f "$STORE/$id/inspect.json" ]; then
    jq -c --argjson rec "$record" '. + [$rec]' "$STORE/$id/inspect.json" | write_atomic "$STORE/$id/inspect.json"
  else
    jq -c -n --argjson rec "$record" '[$rec]' | write_atomic "$STORE/$id/inspect.json"
  fi
  mutate "$id" "$REV" inspect '
    .execution.reconciled_at = (.execution.reconciled_at // $now)
    | .artifact.digest = $a.digest | .artifact.changed = $a.changed
    | .artifact.out_of_scope = $a.out_of_scope | .artifact.overlaps_baseline = $a.overlaps_baseline
    | .artifact.plan_touched = $a.plan_touched
    | .artifact.inspections += [{at: $now, digest: $a.digest}]
    | if .claim == null then .artifact.target_after = $a.digest else . end' --argjson a "$art"
  if [ "$JSON_OUT" = 1 ]; then
    jq -c --slurpfile r "$STORE/$id/receipt.json" '{id: $r[0].id, rev: $r[0].rev} + (. | del(.entries)) + {paths: [.entries[].path]}' <<<"$art"
  else
    rfield "$id" .rev
  fi
}

# ---------------------------------------------------------------- command: verdict

parse_check() { # <spec> -> JSON {name, exit, file}
  local spec="$1" name rest code file
  name="${spec%=*}"
  rest="${spec##*=}"
  [ "$name" != "$spec" ] || die $E_USAGE "--check must be <name>=<exit>:<output file>"
  code="${rest%%:*}"
  file="${rest#*:}"
  [[ "$code" =~ ^-?[0-9]+$ ]] && [ "$file" != "$rest" ] || die $E_USAGE "--check must be <name>=<exit>:<output file>"
  [ -f "$file" ] || die $E_USAGE "check output not found: $file"
  jq -n -c --arg n "$name" --arg c "$code" --arg f "$file" '{name: $n, exit: ($c | tonumber), file: $f}'
}

store_checks() { # <id> <check json>... -> JSON array for verdict.checks
  local id="$1" n out="[]" c
  shift
  mkdir -p "$STORE/$id/checks"
  n="$(find "$STORE/$id/checks" -type f | wc -l | tr -d ' ')"
  for c in "$@"; do
    n=$((n + 1))
    cp "$(jq -r .file <<<"$c")" "$STORE/$id/checks/$n.txt"
    out="$(jq -c --argjson c "$c" --arg o "checks/$n.txt" '. + [{name: $c.name, exit: $c.exit, output: $o}]' <<<"$out")"
  done
  printf '%s\n' "$out"
}

recompute_task_digests() { # <id> -> "ok" or a reason
  local r plan tid input path digest
  r="$(receipt_of "$1")"
  plan="$(jq -r '.task.planner_repo + "/" + (.task.ref | sub("#.*"; ""))' <<<"$r")"
  tid="$(jq -r '.task.ref | sub(".*#"; "")' <<<"$r")"
  [ -f "$plan" ] || { echo "plan missing: $plan"; return; }
  digest="$(task_block "$plan" "$tid" | digest_stdin)" || { echo "task $tid missing or not unique"; return; }
  [ "$digest" = "$(jq -r .task.digest <<<"$r")" ] || { echo "task text changed since the attempt was created"; return; }
  while IFS= read -r input; do
    [ -n "$input" ] || continue
    path="$(jq -r .path <<<"$input")"
    case "$path" in /*) ;; *) path="$(jq -r .task.planner_repo <<<"$r")/$path" ;; esac
    [ -f "$path" ] || { echo "input missing: $path"; return; }
    [ "$(digest_file "$path")" = "$(jq -r .digest <<<"$input")" ] || { echo "input changed: $path"; return; }
  done < <(jq -c '.task.inputs[]' <<<"$r")
  echo ok
}

cmd_verdict() {
  local id="$1" what="${2:-}" code="" reason="" into="" head="" override="" checks=()
  shift 2 || die $E_USAGE "verdict <id> accept|reject ..."
  REV=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --rev) REV="$2"; shift 2 ;;
      --check) checks+=("$(parse_check "$2")"); shift 2 ;;
      --reason-code) code="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      --integrated-into) into="$2"; shift 2 ;;
      --integrated-head) head="$2"; shift 2 ;;
      --scope-override) override="$2"; shift 2 ;;
      *) die $E_USAGE "verdict: unknown option $1" ;;
    esac
  done
  parse_rev verdict
  resolve_store
  require_id "$id"
  with_attempt_locks "$id"
  check_rev "$id" "$REV"
  [ "$(rfield "$id" .verdict.acceptance)" = pending ] || die $E_STATE "verdict: $id already has verdict $(rfield "$id" .verdict.acceptance)"
  [ -z "$into" ] && [ -z "$head" ] || { [ -n "$into" ] && [ -n "$head" ]; } ||
    die $E_USAGE "--integrated-into and --integrated-head go together"
  case "$what" in
    accept) verdict_accept "$id" "$into" "$head" "$override" ${checks[@]+"${checks[@]}"} ;;
    reject)
      [ -n "$code" ] && [ -n "$reason" ] || die $E_USAGE "verdict reject needs --reason-code and --reason"
      [ "$code" != abandoned ] || die $E_USAGE "use abandon for a never-launched attempt"
      local stored="[]" basis_filter="."
      [ "${#checks[@]}" -eq 0 ] || stored="$(store_checks "$id" "${checks[@]}")"
      if release_basis_if_resolved "$id" "$(rfield "$id" .execution.observation)" rejected "$code" no; then
        basis_filter="$claim_release_filter"
      fi
      mutate "$id" "$REV" "verdict: rejected ($code)" '
        .verdict.acceptance = "rejected" | .verdict.reason_code = $code | .verdict.reason = $reason
        | .verdict.checks = $checks | .verdict.at = $now | '"$basis_filter" \
        --arg code "$code" --arg reason "$reason" --argjson checks "$stored" --arg basis resolved
      ;;
    *) die $E_USAGE "verdict: accept or reject" ;;
  esac
  emit_rev "$id"
}

verdict_accept() {
  local id="$1" into="$2" head="$3" override="$4" r stale art settle n
  shift 4
  r="$(receipt_of "$id")"
  # 1. stopped with safe evidence (only the helper could have recorded it) and reconciled
  [ "$(jq -r .execution.observation <<<"$r")" = stopped ] || die $E_STATE "accept: $id is not stopped (I-8)"
  [ "$(jq -r '.execution.reconciled_at // ""' <<<"$r")" != "" ] || die $E_STATE "accept: $id was never inspected"
  if [ "$(jq -r .execution.stop_evidence <<<"$r")" = exit+pgroup-empty ] &&
    [ "$(cap "$id" descendants_may_outlive)" != unsupported ]; then
    die $E_STATE "accept: exit+pgroup-empty is not safe for this executor card"
  fi
  # 2. valid, submitted result
  [ "$(jq -r .result.status <<<"$r")" = valid ] || die $E_STATE "accept: $id has no valid result"
  [ "$(jq -r .result.disposition <<<"$r")" = submitted ] ||
    die $E_STATE "accept: the worker returned $(jq -r .result.disposition <<<"$r"), not submitted"
  # 3. task and input digests unchanged
  stale="$(recompute_task_digests "$id")"
  [ "$stale" = ok ] || die $E_STATE "accept: stale — $stale; reject with --reason-code stale and start a new attempt"
  # 4. artifact unchanged since the last inspection, and settled when the card asks
  art="$(compute_artifact "$id")"
  [ "$(jq -r .digest <<<"$art")" = "$(jq -r .artifact.digest <<<"$r")" ] ||
    die $E_STATE "accept: the artifact changed after the last inspection; inspect again"
  settle="$(card_value "$id" stop.settle_seconds 0)"
  [[ "$settle" =~ ^[0-9]+$ ]] || settle=0
  if [ "$settle" -gt 0 ]; then
    jq -e --argjson s "$settle" '.artifact.inspections as $i | ($i | length) >= 2
      and $i[-1].digest == $i[-2].digest
      and (($i[-1].at | fromdateiso8601) - ($i[-2].at | fromdateiso8601)) >= $s' <<<"$r" >/dev/null ||
      die $E_STATE "accept: the card asks for two equal inspections at least ${settle}s apart (artifact stability)"
  fi
  # 5. scope and plan
  if [ "$(jq -r '(.artifact.out_of_scope | length) > 0 or .artifact.plan_touched' <<<"$r")" = true ] && [ -z "$override" ]; then
    die $E_STATE "accept: out-of-scope paths $(jq -c .artifact.out_of_scope <<<"$r") / plan touched $(jq -r .artifact.plan_touched <<<"$r"); reject scope_violation/plan_tampered, or restore, re-inspect and pass --scope-override"
  fi
  # 6. at least one passing host check
  [ "$#" -gt 0 ] || die $E_STATE "accept: at least one --check is required (I-10)"
  local passing=0 c
  for c in "$@"; do [ "$(jq -r .exit <<<"$c")" != 0 ] || passing=1; done
  [ "$passing" = 1 ] || die $E_STATE "accept: no --check passed"
  local stored
  stored="$(store_checks "$id" "$@")"
  # 7. the written receipt is validated against the whole contract by mutate
  mutate "$id" "$REV" "verdict: accepted" '
    .verdict.acceptance = "accepted" | .verdict.task_digest = .task.digest
    | .verdict.artifact_digest = $d | .verdict.checks = $checks | .verdict.at = $now
    | .verdict.integration = (if $into == "" then null else {into: $into, head: $head} end)
    | .verdict.scope_override = (if $ov == "" then null else $ov end)' \
    --arg d "$(jq -r .digest <<<"$art")" --argjson checks "$stored" \
    --arg into "$into" --arg head "$head" --arg ov "$override"
}

# ---------------------------------------------------------------- command: projected

cmd_projected() {
  local id="$1" plan=""
  shift
  REV=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --rev) REV="$2"; shift 2 ;;
      --plan) plan="$2"; shift 2 ;;
      *) die $E_USAGE "projected: unknown option $1" ;;
    esac
  done
  parse_rev projected
  [ -n "$plan" ] && [ -f "$plan" ] || die $E_USAGE "projected needs --plan <file>"
  resolve_store
  require_id "$id"
  with_attempt_locks "$id"
  check_rev "$id" "$REV"
  [ "$(rfield "$id" .verdict.acceptance)" = accepted ] || die $E_STATE "projected: $id has no persisted accepted verdict (I-11)"
  [ "$(rfield "$id" '.verdict.projected_at // ""')" = "" ] || die $E_STATE "projected: $id is already projected"
  local tid block
  tid="$(rfield "$id" '.task.ref | sub(".*#"; "")')"
  block="$(task_block_or_die "$plan" "$tid" raw)"
  printf '%s\n' "$block" | head -n 1 | grep -Eq -- '- \[[xX]\]' ||
    die $E_STATE "projected: task $tid is not ticked in $plan"
  printf '%s\n' "$block" | grep -E -- '^[[:space:]]*- Dispatched:' | grep -F -- "attempt: $id" | grep -Fq -- 'accepted' ||
    die $E_STATE "projected: no accepted Dispatched line naming attempt: $id under task $tid"
  local basis_filter="."
  if release_basis_if_resolved "$id" stopped accepted "" yes; then
    basis_filter="$claim_release_filter"
  fi
  mutate "$id" "$REV" projected '.verdict.projected_at = $now | '"$basis_filter" --arg basis resolved
  emit_rev "$id"
}

# ---------------------------------------------------------------- command: release-claim

cmd_release_claim() {
  local id="$1" who="" reason="" repo=""
  shift
  REV=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --rev) REV="$2"; shift 2 ;;
      --attested-by) who="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      --repo) repo="$2"; shift 2 ;;
      *) die $E_USAGE "release-claim: unknown option $1" ;;
    esac
  done
  [ -n "$who" ] && [ -n "$reason" ] || die $E_USAGE "release-claim needs --attested-by <who> and --reason <text>"
  [[ "$id" =~ $ID_RE ]] || die $E_USAGE "not an attempt id: $id"
  resolve_store
  if [ ! -f "$STORE/$id/receipt.json" ]; then
    # A dangling claim whose holder store is gone (design 10.4).
    [ -n "$repo" ] || die $E_USAGE "$id is not in $STORE; pass --repo <target> to release a claim whose holder store is unreadable"
    local ns f
    ns="$(claims_ns_of_repo "$repo")"
    mutex_acquire "$ns"
    while IFS= read -r f <&3; do
      [ "$(jq -r .holder "$f")" = "$id" ] || continue
      [ ! -f "$(jq -r .store "$f")/$id/receipt.json" ] ||
        die $E_STATE "the holder store $(jq -r .store "$f") is readable; release from that store"
      release_claim_files "$ns" "$(jq -r .key "$f")" "$id" "attested:$who ($reason)"
      echo "released claim of $id on $repo"
      return
    done 3< <(live_claims "$ns")
    die $E_STATE "no live claim in $ns names $id"
  fi
  parse_rev release-claim
  with_attempt_locks "$id"
  check_rev "$id" "$REV"
  [ "$(rfield "$id" .execution.observation)" = stopped ] ||
    die $E_GUARD "release-claim: $id has ownership risk ($(rfield "$id" .execution.observation)); it must first be observed stopped"
  [ "$(rfield "$id" '.claim.state // ""')" = held ] || die $E_STATE "release-claim: $id does not hold a claim"
  claim_names "$id" || die $E_STATE "release-claim: the claim file does not name $id; run validate"
  MUTATE_RELEASE=("$(rfield "$id" .claim.namespace)" "$(rfield "$id" .claim.key)" "$id" "attested:$who ($reason)")
  mutate "$id" "$REV" "release-claim by $who: $reason" "$claim_release_filter" --arg basis "attested:$who ($reason)"
  emit_rev "$id"
}

# ---------------------------------------------------------------- read-only commands

cmd_claims() {
  local repo="." ns f
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      *) die $E_USAGE "claims: unknown option $1" ;;
    esac
  done
  resolve_store
  ns="$(claims_ns_of_repo "$repo")"
  local store holder rcpt obs verdict dangling
  while IFS= read -r f <&3; do
    obs="?"
    verdict="?"
    dangling=false
    store="$(jq -r .store "$f")"
    holder="$(jq -r .holder "$f")"
    rcpt="$store/$holder/receipt.json"
    if [ -f "$rcpt" ]; then
      obs="$(jq -r .execution.observation "$rcpt")"
      verdict="$(jq -r 'if .verdict.reason_code then "\(.verdict.acceptance) (\(.verdict.reason_code))" else .verdict.acceptance end' "$rcpt")"
    else
      dangling=true
    fi
    jq -c --arg obs "$obs" --arg v "$verdict" --argjson d "$dangling" --arg now "$NOW" '{
        key, holder, store, location, acquired_at,
        age_seconds: (($now | fromdateiso8601) - (.acquired_at | fromdateiso8601)),
        holder_observation: $obs, holder_verdict: $v, dangling: $d }' "$f"
  done 3< <(live_claims "$ns") | if [ "$JSON_OUT" = 1 ]; then jq -s -c .; else
    jq -r '"\(.key)\t\(.holder)\t\(.holder_observation)\t\(.holder_verdict)\tage \(.age_seconds)s\t\(if .dangling then "DANGLING (store unreadable: \(.store))" else .store end)"'
  fi
}

cmd_digest() {
  case "${1:-}" in
    task)
      local plan="" task=""
      shift
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --plan) plan="$2"; shift 2 ;;
          --task) task="$2"; shift 2 ;;
          *) die $E_USAGE "digest task: unknown option $1" ;;
        esac
      done
      [ -n "$plan" ] && [ -n "$task" ] || die $E_USAGE "digest task --plan <file> --task <id>"
      task_digest "$plan" "$task"
      echo
      ;;
    artifact)
      resolve_store
      require_id "${2:-}"
      compute_artifact "$2" | if [ "$JSON_OUT" = 1 ]; then cat; else jq -r .digest; fi
      ;;
    *) die $E_USAGE "digest task|artifact ..." ;;
  esac
}

# Recovery classes (design 13.2) from a receipt; stale is computed separately.
CLASS_JQ='
  def risk: .execution.observation == "running" or .execution.observation == "unknown";
  def resolved: .execution.observation == "stopped" and .verdict.acceptance != "pending"
    and (.verdict.acceptance != "accepted" or .verdict.projected_at != null);
  [ ( if .execution.observation == "prepared" then "C1"
      elif (risk and .execution.cancel_requested_at != null) then "C8"
      elif .execution.observation == "unknown" and .handle.pid == null and .handle.provider_session == null then "C2"
      elif risk then "C3"
      elif .verdict.acceptance == "accepted" and .verdict.projected_at == null then "C6"
      elif .verdict.acceptance == "pending" and .result.status == "valid" then "C4"
      elif .verdict.acceptance == "pending" then "C5"
      elif .claim != null and .claim.state == "held" then "C11"
      else empty end ),
    ( if $stale == "stale" and (resolved | not) then "C7" else empty end ),
    ( if .continues != null and (resolved | not) then "C10" else empty end ) ]'

cmd_list() {
  local unresolved=0 task="" f id stale
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --unresolved) unresolved=1; shift ;;
      --task) task="$2"; shift 2 ;;
      *) die $E_USAGE "list: unknown option $1" ;;
    esac
  done
  resolve_store
  [ -d "$STORE" ] || { [ "$JSON_OUT" = 1 ] && echo '[]'; return 0; }
  for f in "$STORE"/pd-*/receipt.json; do
    [ -f "$f" ] || continue
    id="$(jq -r .id "$f")"
    [ -z "$task" ] || [ "$(jq -r .task.ref "$f")" = "$task" ] || continue
    stale=fresh
    if ! is_resolved "$id"; then
      [ "$(recompute_task_digests "$id")" = ok ] || stale=stale
    fi
    jq -c --arg stale "$stale" --arg now "$NOW" "
      ($CLASS_JQ) as \$classes
      | {
          id, task: .task.ref, kind, observation: .execution.observation,
          verdict: (if .verdict.reason_code then .verdict.reason_code | gsub(\"_\"; \" \") else .verdict.acceptance end),
          result: .result.status, projected: (.verdict.projected_at != null),
          ownership_risk: (.execution.observation == \"running\" or .execution.observation == \"unknown\"),
          claim: (.claim.state // \"claim-free\"), classes: \$classes,
          parent_exited: (.handle.parent_exited_at != null), location: .place.location, host: .host,
          age_seconds: ((\$now | fromdateiso8601) - (.created_at | fromdateiso8601)),
          rev
        }" "$f"
  done | if [ "$unresolved" = 1 ]; then jq -c 'select(.classes != [])'; else cat; fi |
    if [ "$JSON_OUT" = 1 ]; then jq -s -c .; else
      jq -r '"\(.id)\t\(.task)\t\(.kind)\t\(.observation)\t\(.verdict)\tresult:\(.result)\t\(if .projected then "projected" else "-" end)\t\(if .ownership_risk then "OWNERSHIP-RISK" else "-" end)\tclaim:\(.claim)\t\(.classes | join(",") | if . == "" then "resolved" else . end)\tage \(.age_seconds)s"'
    fi
}

cmd_validate() {
  local file="" as="" attempt="" ids=() all=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --file) file="$2"; shift 2 ;;
      --as) as="$2"; shift 2 ;;
      --attempt) attempt="$2"; shift 2 ;;
      --all) all=1; shift ;;
      -*) die $E_USAGE "validate: unknown option $1" ;;
      *) ids+=("$1"); shift ;;
    esac
  done
  if [ -n "$file" ]; then
    [ -f "$file" ] || die $E_USAGE "no such file: $file"
    local out
    case "$as" in
      result) out="$(validate_result_file "$file" "$attempt")" ;;
      receipt | claim)
        if [ "$(jq -s 'length' "$file" 2>/dev/null || echo x)" != 1 ]; then
          out='{"valid":false,"errors":[{"path":"","keyword":"parse"}],"semantic":[]}'
        else
          out="$(jq_lib '
            sv_errors($s[0]) as $e
            | (if $kind == "receipt" and ($e == []) then receipt_semantic_errors else [] end) as $sem
            | {valid: ($e == [] and $sem == []), errors: $e, semantic: $sem}' \
            -c --slurpfile s "$(schema_path "$as")" --arg kind "$as" "$file")"
        fi
        ;;
      *) die $E_USAGE "validate --file needs --as receipt|result|claim" ;;
    esac
    if [ "$JSON_OUT" = 1 ]; then printf '%s\n' "$out"; else
      jq -r 'if .valid then "valid" else "invalid: " + ([(.errors[]? | "\(.keyword) at \(if .path == "" then "/" else .path end)"), (.semantic[]?), (.diagnostics[]?)] | unique | join("; ")) end' <<<"$out"
    fi
    [ "$(jq -r .valid <<<"$out")" = true ] || exit $E_INVALID
    return 0
  fi
  resolve_store
  if [ "$all" = 1 ]; then
    local f
    for f in "$STORE"/pd-*/receipt.json; do [ -f "$f" ] && ids+=("$(jq -r .id "$f")"); done
  fi
  [ "${#ids[@]}" -gt 0 ] || die $E_USAGE "validate <id>...|--all|--file <f> --as <kind>"
  local id bad=0 problems holders=""
  for id in "${ids[@]}"; do
    require_id "$id"
    problems="$(receipt_problems "$(receipt_of "$id")")"
    # Card-dependent rule: pgroup evidence is safe only for a measured card.
    if [ "$(rfield "$id" '.execution.stop_evidence // ""')" = exit+pgroup-empty ] &&
      [ "$(cap "$id" descendants_may_outlive)" != unsupported ]; then
      problems="${problems:+$problems
}invariant: stop-evidence-unsafe-for-card"
    fi
    # Projection vs the authoritative claim file (reported, never repaired here).
    if [ "$(rfield "$id" '.claim.state // ""')" = held ] && ! claim_names "$id"; then
      problems="${problems:+$problems
}invariant: held-claim-not-in-claim-file"
    fi
    if [ "$(rfield "$id" '.claim.state // ""')" = held ]; then
      local hk
      hk="$(rfield "$id" '.claim.namespace + "|" + .claim.key')"
      case "$holders" in
        *"|$hk|"*) problems="${problems:+$problems
}invariant: two-holders-of-one-claim-key ($hk)" ;;
      esac
      holders="$holders|$hk|"
    fi
    if [ -n "$problems" ]; then
      bad=1
      printf '%s\n' "$problems" | sed "s/^/$id: /"
    elif [ "$JSON_OUT" = 0 ]; then
      printf '%s: valid\n' "$id"
    fi
  done
  [ "$bad" = 0 ] || exit $E_INVALID
}

usage() {
  cat <<'EOF'
usage: passdown-attempt [--store <dir>] [--card-dir <dir>] [--json] <command> [args]

  new --task-ref <plan#id> --kind write|read|reemit|salvage --tier current|native|external
      --reason-code <c> --reason <text> --executor <name> --host <agent> --place-repo <repo>
      --isolation current-checkout|worktree|read-only [--card <name@v>] [--session <s>]
      [--planner-repo <repo>] [--base-ref <ref>] [--location <dir>] [--worktree-dir <dir>]
      [--profile <name> [--profile-keys loc]] [--continues <id>] [--input <path>]... [--answer <file>]
      [--mutation-guard readonly:<m>|snapshot+sandbox] [--invocation <argv template>]
  arm <id> --rev <n> --prompt <file>
  observe <id> running --rev <n> (--pid <n> [--pid-started <s>] [--pgid <n>] | --provider-session <s>)
                       [--containment pgroup|scope --scope <cgroup dir>]
  observe <id> unknown --rev <n> --note <text> [--parent-exited]
  observe <id> stopped --rev <n> --evidence not-launched|exit+scope-empty|exit+pgroup-empty|owner-attested
                       [--exit <code>] [--signal <sig>] [--attested-by <who>]
  abandon <id> --rev <n> [--attested-by <who>]
  probe <id>
  cancel <id> --rev <n> --method <m>
  result <id> --rev <n> --payload <file>
  inspect <id> --rev <n>
  verdict <id> accept --rev <n> --check <name>=<exit>:<output file>... [--integrated-into <dir>
                      --integrated-head <sha>] [--scope-override <reason>]
  verdict <id> reject --rev <n> --reason-code <c> --reason <text> [--check ...]
  projected <id> --rev <n> --plan <file>
  release-claim <id> --rev <n> --attested-by <who> --reason <text> [--repo <target>]
  claims [--repo <target>]
  digest task --plan <file> --task <id> | digest artifact <id>
  validate <id>... | validate --all | validate --file <f> --as receipt|result|claim [--attempt <id>]
  list [--unresolved] [--task <plan#id>]
  version

Exit codes: 0 ok, 2 usage, 3 invalid transition or failed precondition,
4 validation failed, 5 rev conflict, 6 guard refused (claim held, depth, read guard).
EOF
}

main() {
  command -v jq >/dev/null 2>&1 || die $E_USAGE "jq is required (>= 1.6); delegated v0.5 dispatch is refused without it"
  local arg args=()
  for arg in "$@"; do
    if [ "$arg" = --json ]; then JSON_OUT=1; else args+=("$arg"); fi
  done
  set -- ${args[@]+"${args[@]}"}
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --store) STORE="$2"; shift 2 ;;
      --card-dir) CARD_DIRS="$2${CARD_DIRS:+:$CARD_DIRS}"; shift 2 ;;
      --json) JSON_OUT=1; shift ;;
      -h | --help | help) usage; exit 0 ;;
      *) break ;;
    esac
  done
  [ "$#" -gt 0 ] || { usage >&2; exit $E_USAGE; }
  local cmd="$1"
  shift
  case "$cmd" in
    new) cmd_new "$@" ;;
    arm) [ "$#" -ge 1 ] || die $E_USAGE "arm <id>"; cmd_arm "$@" ;;
    observe) [ "$#" -ge 2 ] || die $E_USAGE "observe <id> <state>"; cmd_observe "$@" ;;
    abandon) [ "$#" -ge 1 ] || die $E_USAGE "abandon <id>"; cmd_abandon "$@" ;;
    probe) [ "$#" -eq 1 ] || die $E_USAGE "probe <id>"; cmd_probe "$1" ;;
    cancel) [ "$#" -ge 1 ] || die $E_USAGE "cancel <id>"; cmd_cancel "$@" ;;
    result) [ "$#" -ge 1 ] || die $E_USAGE "result <id>"; cmd_result "$@" ;;
    inspect) [ "$#" -ge 1 ] || die $E_USAGE "inspect <id>"; cmd_inspect "$@" ;;
    verdict) [ "$#" -ge 2 ] || die $E_USAGE "verdict <id> accept|reject"; cmd_verdict "$@" ;;
    projected) [ "$#" -ge 1 ] || die $E_USAGE "projected <id>"; cmd_projected "$@" ;;
    release-claim) [ "$#" -ge 1 ] || die $E_USAGE "release-claim <id>"; cmd_release_claim "$@" ;;
    claims) cmd_claims "$@" ;;
    digest) cmd_digest "$@" ;;
    validate) cmd_validate "$@" ;;
    list) cmd_list "$@" ;;
    version) echo "$PASSDOWN_VERSION" ;;
    *) die $E_USAGE "unknown command: $cmd (see --help)" ;;
  esac
}

main "$@"
